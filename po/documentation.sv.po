msgstr "liknar ++%<(++_<n>_++)++, ++%<|(++_<m>_++)++ respektive, men utfyllnad på båda sidor (dvs. texten centreras)"

#. type: Plain text
#: en/pretty-formats.adoc:210
#, priority:260
msgid "Placeholders that expand to information extracted from the commit:"
msgstr "Platshållare som expanderar till information som extraheras från incheckningen:"

#. type: Labeled list
#: en/pretty-formats.adoc:212
