msgid "Do *not* use this option unless you have read the note for linkgit:git-clone[1]'s `--reference`, `--shared`, and `--dissociate` options carefully."
msgstr "*OBS*: Använd *inte* det här alternativet om du inte noggrant har läst igenom anmärkningen för linkgit:git-clone[1]s alternativ `--reference`, `--shared` och `--dissociate`."

#. type: Plain text
#: en/git-submodule.adoc:434
#, fuzzy, placeholders:'linkgit:git-clone[1]', priority:220
