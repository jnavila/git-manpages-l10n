#. type: Title =
#: en/git-checkout.adoc:2
#, ignore-same, no-wrap, priority:240
msgid "git-checkout(1)"
msgstr "git-checkout(1)"

#. type: Plain text
#: en/git-checkout.adoc:7
#, placeholders:'git-checkout', priority:240
msgid "git-checkout - Switch branches or restore working tree files"
msgstr "git-checkout - Byt gren eller återställ filer i arbetsträdet"

#. type: synopsis
#: en/git-checkout.adoc:20
#, ignore-ellipsis, no-wrap, placeholders:'--detach':'[--detach]':'--orphan]':'--pathspec-from-file=':'[--pathspec-file-nul]':'--ours':'--theirs':'--conflict=':'--ours':'--theirs':'--conflict=':'--pathspec-from-file=':'[--pathspec-file-nul]':'--patch', priority:240
msgid ""
"git checkout [-q] [-f] [-m] [<branch>]\n"
"git checkout [-q] [-f] [-m] --detach [<branch>]\n"
"git checkout [-q] [-f] [-m] [--detach] <commit>\n"
"git checkout [-q] [-f] [-m] [[-b|-B|--orphan] <new-branch>] [<start-point>]\n"
"git checkout <tree-ish> [--] <pathspec>...\n"
"git checkout <tree-ish> --pathspec-from-file=<file> [--pathspec-file-nul]\n"
"git checkout [-f|--ours|--theirs|-m|--conflict=<style>] [--] <pathspec>...\n"
"git checkout [-f|--ours|--theirs|-m|--conflict=<style>] --pathspec-from-file=<file> [--pathspec-file-nul]\n"
"git checkout (-p|--patch) [<tree-ish>] [--] [<pathspec>...]\n"
msgstr ""
"git checkout [-q] [-f] [-m] [<gren>]\n"
"git checkout [-q] [-f] [-m] --detach [<gren>]\n"
"git checkout [-q] [-f] [-m] [--detach] <incheckning>\n"
"git checkout [-q] [-f] [-m] [[-b|-B|--orphan] <ny-grel>] [<start-punkt>]\n"
"git checkout <tree-ish> [--] <sökvägsspec>...\n"
"git checkout <tree-ish> --pathspec-from-file=<fil> [--pathspec-file-nul]\n"
"git checkout [-f|--ours|--theirs|-m|--conflict=<stil>] [--] <sökvägsmönster>...\n"
"git checkout [-f|--ours|--theirs|-m|--conflict=<stil>] --pathspec-from-file=<file> [--pathspec-file-nul]\n"
"git checkout (-p|--patch) [<trädlikt>] [--] [<sökvägsspec>...]\n"

#. type: Plain text
#: en/git-checkout.adoc:25
#, priority:240
msgid "`git checkout` has two main modes:"
msgstr "`git checkout` har två huvudlägen:"

#. type: Plain text
#: en/git-checkout.adoc:27
#, priority:240
msgid "**Switch branches**, with `git checkout <branch>`"
msgstr "**Byt grenar**, med `git checkout <gren>`"

#. type: Plain text
#: en/git-checkout.adoc:29
#, priority:240
msgid "**Restore a different version of a file**, for example with `git checkout <commit> <filename>` or `git checkout <filename>`"
msgstr "**Återställ en annan version av en fil**, till exempel med `git checkout <incheckning> <filnamn>` eller `git checkout <filnamn>`"

#. type: Plain text
#: en/git-checkout.adoc:31
#, priority:240
msgid "See ARGUMENT DISAMBIGUATION below for how Git decides which one to do."
msgstr "Se ARGUMENT SÄRSKILJNING nedan för hur Git bestämmer vilken som ska göras."

#. type: Labeled list
#: en/git-checkout.adoc:32
#, no-wrap, priority:240
msgid "`git checkout [<branch>]`"
msgstr "`git checkout [<gren>]`"

#. type: Plain text
#: en/git-checkout.adoc:38
#, priority:240
msgid "Switch to _<branch>_. This sets the current branch to _<branch>_ and updates the files in your working directory. The checkout will fail if there are uncommitted changes to any files where _<branch>_ and your current commit have different content. Uncommitted changes will otherwise be kept."
msgstr "Växla till _<gren>_. Detta ställer in den aktuella grenen till _<gren>_ och uppdaterar filerna i din arbetskatalog. Utcheckningen kommer att misslyckas om det finns oincheckade ändringar i filer där _<gren>_ och din nuvarande incheckning har olika innehåll. Oincheckade ändringar kommer annars att behållas."

#. type: Plain text
#: en/git-checkout.adoc:42
#, placeholders:'`--no-guess`', priority:240
msgid "If _<branch>_ is not found but there does exist a tracking branch in exactly one remote (call it _<remote>_) with a matching name and `--no-guess` is not specified, treat as equivalent to"
msgstr "Om _<gren>_ inte hittas men det finns en spårningsgren i exakt en fjärr (kalla den _<fjärr>_) med ett matchande namn och `--no-guess` inte är specificerat, behandla den som likvärdig med"

#. type: delimited block -
#: en/git-checkout.adoc:45 en/git-checkout.adoc:188
#, no-wrap, placeholders:'--track', priority:240
msgid "$ git checkout -b <branch> --track <remote>/<branch>\n"
msgstr "$ git checkout -b <gren> --track <fjärr>/<gren>\n"

#. type: Plain text
#: en/git-checkout.adoc:49
#, priority:240
msgid "Running `git checkout` without specifying a branch has no effect except to print out the tracking information for the current branch."
msgstr "Att köra `git checkout` utan att ange en gren har ingen effekt förutom att skriva ut spårningsinformationen för den aktuella grenen."

#. type: Labeled list
#: en/git-checkout.adoc:50
#, no-wrap, priority:240
msgid "`git checkout -b <new-branch> [<start-point>]`"
msgstr "`git checkout -b <ny-gren> [<start-punkt>]`"

#. type: Plain text
#: en/git-checkout.adoc:56
#, placeholders:'`--track`':'`--no-track`', priority:240
msgid "Create a new branch named _<new-branch>_, start it at _<start-point>_ (defaults to the current commit), and check out the new branch. You can use the `--track` or `--no-track` options to set the branch's upstream tracking information."
msgstr "Skapa en ny gren med namnet _<ny-gren>_, starta den vid _<start-punkt>_ (standardinställningen är den nuvarande incheckningen) och checka ut den nya grenen. Du kan använda alternativen `--track` eller `--no-track` för att ställa in grenens uppströms spårningsinformation."

#. type: Plain text
#: en/git-checkout.adoc:60
#, priority:240
msgid "This will fail if there's an error checking out _<new-branch>_, for example if checking out the `<start-point>` commit would overwrite your uncommitted changes."
msgstr "Det kommer att misslyckas om det uppstår ett fel vid utcheckning av _<ny-gren>_, till exempel om utcheckning av `<start-punkt>`-incheckningen skulle skriva över oincheckade ändringar."

#. type: Labeled list
#: en/git-checkout.adoc:61
#, no-wrap, priority:240
msgid "`git checkout -B <branch> [<start-point>]`"
msgstr "`git checkout -B <gren> [<start-punkt>]`"

#. type: Plain text
#: en/git-checkout.adoc:65 en/git-checkout.adoc:159
#, placeholders:'`-b`', priority:240
msgid "The same as `-b`, except that if the branch already exists it resets _<branch>_ to the start point instead of failing."
msgstr "Samma som `-b`, förutom att om grenen redan finns återställer den _<gren>_ till startpunkten i stället för att misslyckas."

#. type: Labeled list
#: en/git-checkout.adoc:66
#, no-wrap, placeholders:'--detach', priority:240
msgid "`git checkout --detach [<branch>]`"
msgstr "`git checkout --detach [<gren>]`"

#. type: Labeled list
#: en/git-checkout.adoc:67
#, no-wrap, placeholders:'[--detach]', priority:240
msgid "`git checkout [--detach] <commit>`"
msgstr "`git checkout [--detach] <incheckning>`"

#. type: Plain text
#: en/git-checkout.adoc:72
#, placeholders:'`HEAD`':'`HEAD`', priority:240
msgid "The same as `git checkout <branch>`, except that instead of pointing `HEAD` at the branch, it points `HEAD` at the commit ID. See the \"DETACHED HEAD\" section below for more."
msgstr "Samma som `git checkout <gren>`, förutom att den i stället för att peka `HEAD` mot grenen pekar `HEAD` mot inchecknings-ID:t. Se avsnittet \"FRÅNKOPPLAT HEAD\" nedan för mer information."

#. type: Plain text
#: en/git-checkout.adoc:74
#, placeholders:'`HEAD`', priority:240
msgid "Omitting _<branch>_ detaches `HEAD` at the tip of the current branch."
msgstr "Om man utelämnar _<gren>_ lossnar `HEAD` i toppen av den aktuella grenen."

#. type: Labeled list
#: en/git-checkout.adoc:75
#, ignore-ellipsis, no-wrap, priority:240
msgid "`git checkout <tree-ish> [--] <pathspec>...`"
msgstr "`git checkout <trädlikt> [--] <sökvägsmönster>...`"

#. type: Labeled list
#: en/git-checkout.adoc:76
#, no-wrap, placeholders:'--pathspec-from-file=':'[--pathspec-file-nul]', priority:240
msgid "`git checkout <tree-ish> --pathspec-from-file=<file> [--pathspec-file-nul]`"
msgstr "`git checkout <trädlikt> --pathspec-from-file=<fil> [--pathspec-file-nul]`"

#. type: Plain text
#: en/git-checkout.adoc:81
#, priority:240
msgid "Replace the specified files and/or directories with the version from the given commit or tree and add them to the index (also known as \"staging area\")."
msgstr "Ersätt de angivna filerna och/eller katalogerna med versionen från den givna incheckningen eller trädet och lägg till dem i indexet (även känt som \"prepareringsytan\")."

#. type: Plain text
#: en/git-checkout.adoc:84
#, priority:240
msgid "For example, `git checkout main file.txt` will replace `file.txt` with the version from `main`."
msgstr "Till exempel, kommer `git checkout main file.txt` att ersätta `file.txt` med versionen från `main`."

#. type: Labeled list
#: en/git-checkout.adoc:85
#, ignore-ellipsis, no-wrap, placeholders:'--ours':'--theirs':'--conflict=', priority:240
msgid "`git checkout [-f|--ours|--theirs|-m|--conflict=<style>] [--] <pathspec>...`"
msgstr "`git checkout [-f|--ours|--theirs|-m|--conflict=<style>] [--] <sökvägsmönster>...`"

#. type: Labeled list
#: en/git-checkout.adoc:86
#, no-wrap, placeholders:'--ours':'--theirs':'--conflict=':'--pathspec-from-file=':'[--pathspec-file-nul]', priority:240
msgid "`git checkout [-f|--ours|--theirs|-m|--conflict=<style>] --pathspec-from-file=<file> [--pathspec-file-nul]`"
msgstr "`git checkout [-f|--ours|--theirs|-m|--conflict=<stil>] --pathspec-from-file=<file> [--pathspec-file-nul]`"

#. type: Plain text
#: en/git-checkout.adoc:90
#, priority:240
msgid "Replace the specified files and/or directories with the version from the index."
msgstr "Ersätt de angivna filerna och/eller katalogerna med versionen från indexet."

#. type: Plain text
#: en/git-checkout.adoc:94
#, priority:240
msgid "For example, if you check out a commit, edit `file.txt`, and then decide those changes were a mistake, `git checkout file.txt` will discard any unstaged changes to `file.txt`."
msgstr "Om du till exempel checkar ut en incheckning, redigerar `file.txt` och sedan bestämmer dig för att ändringarna var ett misstag, kommer `git checkout file.txt` att ignorera alla ej köade ändringar av `file.txt`."

#. type: Plain text
#: en/git-checkout.adoc:101
#, placeholders:'`-f`':'`--ours`':'`--theirs`':'`-m`', priority:240
msgid "This will fail if the file has a merge conflict and you haven't yet run `git add file.txt` (or something equivalent) to mark it as resolved. You can use `-f` to ignore the unmerged files instead of failing, use `--ours` or `--theirs` to replace them with the version from a specific side of the merge, or use `-m` to replace them with the original conflicted merge result."
msgstr "Det kommer att misslyckas om filen har en sammanslagningskonflikt och ännu inte har kört `git add file.txt` (eller något motsvarande) för att markera den som löst. `-f` kan användas för att ignorera de icke-sammanslagna filerna i stället för att misslyckas, använda `--ours` eller `--theirs` för att ersätta dem med versionen från en specifik sida av sammanslagningen, eller använda `-m` för att ersätta dem med det ursprungliga konfliktfyllda sammanslagningsresultatet."

#. type: Labeled list
#: en/git-checkout.adoc:102
#, ignore-ellipsis, no-wrap, placeholders:'--patch', priority:240
msgid "`git checkout (-p|--patch) [<tree-ish>] [--] [<pathspec>...]`"
msgstr "`git checkout (-p|--patch) [<trädlikt>] [--] [<sökvägsmönster>...]`"

#. type: Plain text
#: en/git-checkout.adoc:107
#, placeholders:'`--patch`', priority:240
msgid "This is similar to the previous two modes, but lets you use the interactive interface to show the \"diff\" output and choose which hunks to use in the result. See below for the description of `--patch` option."
msgstr "Det liknar de två föregående lägena, men gör det möjligt att använda det interaktiva gränssnittet för att visa \"diff\"-utdata och välja vilka stycken som ska användas i resultatet. Se nedan för beskrivningen av alternativet `--patch`."

#. type: Plain text
#: en/git-checkout.adoc:127
#, placeholders:'`HEAD`', priority:240
msgid "When switching branches, proceed even if the index or the working tree differs from `HEAD`, and even if there are untracked files in the way. This is used to throw away local changes and any untracked files or directories that are in the way."
msgstr "Vid byte av gren, fortsätt även om indexet eller arbetsträdet skiljer sig från `HEAD`, och även om det finns ospårade filer i vägen. Detta används för att ta bort lokala ändringar och eventuella ospårade filer eller kataloger som är i vägen."

#. type: Plain text
#: en/git-checkout.adoc:130
#, priority:240
msgid "When checking out paths from the index, do not fail upon unmerged entries; instead, unmerged entries are ignored."
msgstr "Vid utcheckning av sökvägar från indexet, misslyckas inte med ej sammanslagna poster; i stället ignoreras ej sammanslagna poster."

#. type: Plain text
#: en/git-checkout.adoc:135
#, priority:240
msgid "When checking out paths from the index, check out stage #2 (`ours`) or #3 (`theirs`) for unmerged paths."
msgstr "Vid utcheckning av sökvägar från indexet, kontrollera steg #2 (`vår`) eller #3 (`deras`) för ej sammanslagna sökvägar."

#. type: Plain text
#: en/git-checkout.adoc:140
#, placeholders:'--rebase`':'`--ours`':'`--theirs`', priority:240
msgid "Note that during `git rebase` and `git pull --rebase`, `ours` and `theirs` may appear swapped; `--ours` gives the version from the branch the changes are rebased onto, while `--theirs` gives the version from the branch that holds your work that is being rebased."
msgstr "Observera att under `git rebase` och `git pull --rebase` kan `vår` och `deras` verka omväxlande; `--ours` anger versionen från grenen som ändringarna ombaseras på, medan `--theirs` anger versionen från grenen som innehåller ditt arbete som ombaseras."

#. type: Plain text
#: en/git-checkout.adoc:150
#, priority:240
msgid "This is because `rebase` is used in a workflow that treats the history at the remote as the shared canonical one, and treats the work done on the branch you are rebasing as the third-party work to be integrated, and you are temporarily assuming the role of the keeper of the canonical history during the rebase. As the keeper of the canonical history, you need to view the history from the remote as `ours` (i.e. \"our shared canonical history\"), while what you did on your side branch as `theirs` (i.e. \"one contributor's work on top of it\")."
msgstr "Det beror på att `rebase` används i ett arbetsflöde som behandlar historiken på fjärren som den delade kanoniska, och behandlar arbetet som utförs på grenen som ombaseras som tredjepartsarbete som ska integreras, och rollen som behållare av den kanoniska historiken antas tillfälligt under ombaseringen. Som behållare av den kanoniska historiken måste historiken ses historiken från fjärren som `vår` (dvs. \"vår delade kanoniska historik\"), medan det som gjordes på sidogrenen ses som `deras` (dvs. \"en bidragsgivares arbete ovanpå den\")."

#. type: Plain text
#: en/git-checkout.adoc:155
#, priority:240
msgid "Create a new branch named _<new-branch>_, start it at _<start-point>_, and check the resulting branch out; see linkgit:git-branch[1] for details."
msgstr "Skapa en ny gren med namnet _<my-gren>_, starta den vid _<start-punkt>_ och kontrollera den resulterande utgreningen; se linkgit:git-branch[1] för mer information."

#. type: Plain text
#: en/git-checkout.adoc:165
#, placeholders:'`--track`':'--track', priority:240
msgid "When creating a new branch, set up \"upstream\" configuration. See `--track` in linkgit:git-branch[1] for details. As a convenience, --track without -b implies branch creation."
msgstr "När du skapar en ny gren, konfigurera \"uppström\". Se `--track` i linkgit:git-branch[1] för mer information. För enkelhetens skull innebär --track utan -b att man skapar en gren."

#. type: Plain text
#: en/git-checkout.adoc:175
#, placeholders:'`-b`':'`-b`', priority:240
msgid "If no `-b` option is given, the name of the new branch will be derived from the remote-tracking branch, by looking at the local part of the refspec configured for the corresponding remote, and then stripping the initial part up to the \"*\". This would tell us to use `hack` as the local branch when branching off of `origin/hack` (or `remotes/origin/hack`, or even `refs/remotes/origin/hack`). If the given name has no slash, or the above guessing results in an empty name, the guessing is aborted. You can explicitly give a name with `-b` in such a case."
msgstr "Om inget `-b`-alternativ anges, kommer namnet på den nya grenen att härledas från fjärrspårnings-grenen, genom att titta på den lokala delen av referensspecifikationen som är konfigurerad för motsvarande fjärr, och sedan ta bot den initiala delen upp till \"*\". Detta skulle ange att vi ska använda `hack` som lokal gren när vi förgrenar oss från `origin/hack` (eller `remotes/origin/hack`, eller till och med `refs/remotes/origin/hack`). Om det angivna namnet inte har något snedstreck, eller om ovanstående gissning resulterar i ett tomt namn, avbryts gissningen. Du kan explicit ange ett namn med `-b` i ett sådant fall."

#. type: Plain text
#: en/git-checkout.adoc:207
#, priority:240
msgid "Create the new branch's reflog; see linkgit:git-branch[1] for details."
msgstr "Skapa den nya grenens reflog; se linkgit:git-branch[1] för mer information."

#. type: Plain text
#: en/git-checkout.adoc:215
#, priority:240
msgid "Rather than checking out a branch to work on it, check out a commit for inspection and discardable experiments. This is the default behavior of `git checkout <commit>` when _<commit>_ is not a branch name. See the \"DETACHED HEAD\" section below for details."
msgstr "I stället för att checka ut en gren för att arbeta med den, checka ut en incheckning för inspektion och kasserbara experiment. Detta är standardbeteendet för `git checkout <incheckning>` när _<incheckning>_ inte är ett grennamn. Se avsnittet \"FRÅNKOPPLAT HUVUD (HEAD)\" nedan för mer information."

#. type: Plain text
#: en/git-checkout.adoc:222
#, priority:240
msgid "Create a new unborn branch, named _<new-branch>_, started from _<start-point>_ and switch to it. The first commit made on this new branch will have no parents and it will be the root of a new history totally disconnected from all the other branches and commits."
msgstr "Skapa en ny ofödd gren, med namnet _<ny-gren>_, startad från _<start-punkt>_ och byt till den. Den första incheckning som görs på den här nya grenen kommer inte att ha några föräldrar och den kommer att vara roten till en ny historik som är helt frikopplad från alla andra grenar och incheckningar."

#. type: Plain text
#: en/git-checkout.adoc:227
#, priority:240
msgid "The index and the working tree are adjusted as if you had previously run `git checkout <start-point>`. This allows you to start a new history that records a set of paths similar to _<start-point>_ by easily running `git commit -a` to make the root commit."
msgstr "Indexet och arbetsträdet justeras som om `git checkout <start-punkt>`. Detta gör det möjligt att starta en ny historik som registrerar en uppsättning sökvägar liknande _<start-punkt>_ genom att enkelt köra `git commit -a` för att göra root-incheckningen."

#. type: Plain text
#: en/git-checkout.adoc:233
#, priority:240
msgid "This can be useful when you want to publish the tree from a commit without exposing its full history. You might want to do this to publish an open source branch of a project whose current tree is \"clean\", but whose full history contains proprietary or otherwise encumbered bits of code."
msgstr "Det kan vara användbart när trädet från en incheckning ska publiceras utan att exponera dess fullständiga historik. Det kan till exempel användas för att publicera en öppen källkodsgren av ett projekt vars nuvarande träd är \"rent\", men vars fullständiga historik innehåller proprietära eller på annat sätt begränsade kodbitar."

#. type: Plain text
#: en/git-checkout.adoc:240
#, priority:240
msgid "If you want to start a disconnected history that records a set of paths that is totally different from the one of _<start-point>_, then you should clear the index and the working tree right after creating the orphan branch by running `git rm -rf .` from the top level of the working tree. Afterwards you will be ready to prepare your new files, repopulating the working tree, by copying them from elsewhere, extracting a tarball, etc."
msgstr "Om en frånkopplad historik ska startas som registrerar en uppsättning sökvägar som är helt annorlunda än den för _<startpunkt>_, bör indexet och arbetsträdet rensas direkt efter att den föräldralösa grenen har skapats genom att köra `git rm -rf .` från den översta nivån i arbetsträdet. Efteråt är det möjligt att förbereda de nya filerna, fylla i arbetsträdet igen, kopiera dem från någon annanstans, extrahera en tar-fil, etc."

#. type: Plain text
#: en/git-checkout.adoc:246
#, ignore-ellipsis, placeholders:'`$GIT_DIR/info/sparse-checkout`', priority:240
msgid "In sparse checkout mode, `git checkout -- <path>...` would update only entries matched by _<paths>_ and sparse patterns in `$GIT_DIR/info/sparse-checkout`. This option ignores the sparse patterns and adds back any files in `<path>...`."
msgstr "I glest utchecknings-läge skulle `git checkout -- <sökväg>...` endast uppdatera poster som matchas av _<sökväg>_ och sparse-mönster i `$GIT_DIR/info/sparse-checkout`. Det här alternativet ignorerar de sparse-mönstren och lägger tillbaka alla filer i `<sökväg>...`."

#. type: Plain text
#: en/git-checkout.adoc:263
#, fuzzy, placeholders:'--hard`', priority:240
#| msgid "When switching branches, if you have local modifications to one or more files that are different between the current branch and the branch to which you are switching, the command refuses to switch branches in order to preserve your modifications in context. However, with this option, a three-way merge between the current branch, your working tree contents, and the new branch is done, and you will be on the new branch."
msgid "When switching branches, if you have local modifications to one or more files that are different between the current branch and the branch to which you are switching, the command refuses to switch branches in order to preserve your modifications in context. With this option, the conflicting local changes are automatically stashed before the switch and reapplied afterwards. If the local changes do not overlap with the differences between branches, the switch proceeds without stashing. If reapplying the stash results in conflicts, the entry is saved to the stash list. Resolve the conflicts and run `git stash drop` when done, or clear the working tree (e.g. with `git reset --hard`) before running `git stash pop` later to re-apply your changes."
msgstr "Vid byte av grenar: om det finns lokala ändringar i en eller flera filer som skiljer sig mellan den aktuella grenen och den gren som växlas till, vägrar kommandot att byta gren för att bevara ändringarna i sitt sammanhang. Med det här alternativet görs dock en trevägssammanslagning mellan den aktuella grenen, innehållet i arbetsträdet och den nya grenen, och resultatet blir den nya grenen."

#. type: Plain text
#: en/git-checkout.adoc:267
#, priority:240
msgid "When checking out paths from the index, this option lets you recreate the conflicted merge in the specified paths. This option cannot be used when checking out paths from a tree-ish."
msgstr "När du checkar ut sökvägar från indexet, låter det här alternativet dig återskapa den konfliktfyllda sammanslagningen i de angivna sökvägarna. Det här alternativet kan inte användas när du checkar ut sökvägar från en trädliknande källa."

#. type: Plain text
#: en/git-checkout.adoc:280
#, priority:240
msgid "Interactively select hunks in the difference between the _<tree-ish>_ (or the index, if unspecified) and the working tree. The chosen hunks are then applied in reverse to the working tree (and if a _<tree-ish>_ was specified, the index)."
msgstr "Välj interaktivt bitar i skillnaden mellan _<trädlikt>_ (eller indexet, om inget anges) och arbetsträdet. De valda bitarna tillämpas sedan i omvänd ordning på arbetsträdet (och om ett _<trädlikt>_ angavs, indexet)."

#. type: Plain text
#: en/git-checkout.adoc:284
#, placeholders:'linkgit:git-add[1]':'`--patch`', priority:240
msgid "This means that you can use `git checkout -p` to selectively discard edits from your current working tree. See the \"Interactive Mode\" section of linkgit:git-add[1] to learn how to operate the `--patch` mode."
msgstr "Det betyder att `git checkout -p` kan användas för att selektivt ignorera redigeringar från det nuvarande arbetsträdet. Se avsnittet \"Interaktivt läge\" i linkgit:git-add[1] för information om hur `--patch`-läget."

#. type: Plain text
#: en/git-checkout.adoc:287
#, placeholders:'`--overlay`', priority:240
msgid "Note that this option uses the no overlay mode by default (see also `--overlay`), and currently doesn't support overlay mode."
msgstr "Observera att det här alternativet använder inte överläggsläget som standard (se även `--overlay`), och för närvarande stödes inte överläggsläget."

#. type: Plain text
#: en/git-checkout.adoc:295
#, priority:240
msgid "`git checkout` refuses when the wanted branch is already checked out or otherwise in use by another worktree. This option makes it check the branch out anyway. In other words, the branch can be in use by more than one worktree."
msgstr "`git checkout` vägrar när den önskade grenen redan är utcheckad eller på annat sätt används av ett annat arbetsträd. Den här inställningen gör att den ändå checkar ut grenen. Med andra ord kan grenen användas av mer än ett arbetsträd."

#. type: Plain text
#: en/git-checkout.adoc:301
#, placeholders:'`--no-overwrite-ignore`', priority:240
msgid "Silently overwrite ignored files when switching branches. This is the default behavior. Use `--no-overwrite-ignore` to abort the operation when the new branch contains ignored files."
msgstr "Skriv tyst över ignorerade filer vid byte av gren. Detta är standardbeteendet. Använd `--no-overwrite-ignore` för att avbryta operationen när den nya grenen innehåller ignorerade filer."

#. type: Plain text
#: en/git-checkout.adoc:311
#, placeholders:'`--recurse-submodules`':'`-f`':'`--no-recurse-submodules`':'linkgit:git-submodule[1]':'`HEAD`', priority:240
msgid "Using `--recurse-submodules` will update the content of all active submodules according to the commit recorded in the superproject. If local modifications in a submodule would be overwritten the checkout will fail unless `-f` is used. If nothing (or `--no-recurse-submodules`) is used, submodules working trees will not be updated. Just like linkgit:git-submodule[1], this will detach `HEAD` of the submodule."
msgstr "Genom att använda `--recurse-submodules` uppdateras innehållet i alla aktiva undermoduler enligt den incheckningen som registrerats i superprojektet. Om lokala modifieringar i en undermodul skulle skrivas över kommer utcheckningen att misslyckas om inte `-f` används. Om ingenting (eller `--no-recurse-submodules`) används kommer undermodulernas arbetsträd inte att uppdateras. Precis som med linkgit:git-submodule[1] kommer detta att koppla bort `HEAD` från undermodulen."

#. type: Plain text
#: en/git-checkout.adoc:319
#, placeholders:'`--no-overlay`', priority:240
msgid "In the default overlay mode, `git checkout` never removes files from the index or the working tree. When specifying `--no-overlay`, files that appear in the index and working tree, but not in _<tree-ish>_ are removed, to make them match _<tree-ish>_ exactly."
msgstr "I standard överläggsläget, tar `git checkout` aldrig bort filer från indexet eller arbetsträdet. När `--no-overlay` anges, tas filer som finnsi indexet och arbetsträdet, men inte i _<trädlikt>_, bort, så att de matchar _<trädlikt>_ exakt."

#. type: Labeled list
#: en/git-checkout.adoc:333
#, no-wrap, priority:240
msgid "`<branch>`"
msgstr "`<gren>`"

#. type: Plain text
#: en/git-checkout.adoc:339
#, placeholders:'`HEAD`', priority:240
msgid "Branch to checkout; if it refers to a branch (i.e., a name that, when prepended with \"refs/heads/\", is a valid ref), then that branch is checked out. Otherwise, if it refers to a valid commit, your `HEAD` becomes \"detached\" and you are no longer on any branch (see below for details)."
msgstr "Gren till utcheckning; om den refererar till en gren (dvs. ett namn som, när det inleds med \"refs/heads/\", är en giltig referens), så är den grenen utcheckad. Annars, om den refererar till en giltig incheckning, blir din `HEAD` \"frånkopplad\" och du är inte längre på någon gren (se nedan för detaljer)."

#. type: Plain text
#: en/git-checkout.adoc:343
#, placeholders:'{-N}`':'{-1}`', priority:240
msgid "You can use the `@{-N}` syntax to refer to the N-th last branch/commit checked out using \"git checkout\" operation. You may also specify `-` which is synonymous to `@{-1}`."
msgstr "Du kan använda syntaxen `@{-N}` för att referera till den N:te sista grenen/incheckningen som checkats ut med hjälp av operationen \"git checkout\". Du kan också ange `-` vilket är synonymt med `@{-1}`."

#. type: Plain text
#: en/git-checkout.adoc:354
#, placeholders:'`HEAD`', priority:240
msgid "The name of a commit at which to start the new branch; see linkgit:git-branch[1] for details. Defaults to `HEAD`."
msgstr "Namnet på en incheckning där den nya grenen ska startas; se linkgit:git-branch[1] för mer information. Standardvärdet är `HEAD`."

#. type: Labeled list
#: en/git-checkout.adoc:359
#, no-wrap, priority:240
msgid "_<tree-ish>_"
msgstr "_<trädlikt>_"

#. type: Plain text
#: en/git-checkout.adoc:362
#, priority:240
msgid "Tree to checkout from (when paths are given). If not specified, the index will be used."
msgstr "Träd att checka ut från (när sökvägar anges). Om inget anges kommer indexet att användas."

#. type: Title -
#: en/git-checkout.adoc:376
#, no-wrap, priority:240
msgid "DETACHED HEAD"
msgstr "FRÅNKOPPLAT HEAD"

#. type: Plain text
#: en/git-checkout.adoc:380
#, placeholders:'`HEAD`', priority:240
msgid "`HEAD` normally refers to a named branch (e.g. `master`). Meanwhile, each branch refers to a specific commit. Let's look at a repo with three commits, one of them tagged, and with branch `master` checked out:"
msgstr "`HEAD` refererar normalt till en namngiven gren (t.ex. `master`). Varje gren refererar däremot till en specifik incheckning. Låt oss titta på ett kodförråd med tre incheckningar, varav en är taggad, och med grenen `master` utcheckad:"

#. type: delimited block -
#: en/git-checkout.adoc:389
#, no-wrap, placeholders:'a---b---c', priority:240
msgid ""
"           HEAD (refers to branch 'master')\n"
"            |\n"
"            v\n"
"a---b---c  branch 'master' (refers to commit 'c')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""
"           HEAD (hänvisar till gren 'master')\n"
"            |\n"
"            v\n"
"a---b---c  gren 'master' (rhänvisar to incheckning 'c')\n"
"    ^\n"
"    |\n"
"  tagg 'v2.0' (hänvisar till incheckning 'b')\n"

#. type: Plain text
#: en/git-checkout.adoc:396
#, placeholders:'`HEAD`', priority:240
msgid "When a commit is created in this state, the branch is updated to refer to the new commit. Specifically, `git commit` creates a new commit `d`, whose parent is commit `c`, and then updates branch `master` to refer to new commit `d`. `HEAD` still refers to branch `master` and so indirectly now refers to commit `d`:"
msgstr "När en incheckning skapas i detta tillstånd uppdateras grenen för att referera till den nya incheckningen. Mer specifikt skapar `git commit` en ny incheckning `d`, vars förälder är incheckning `c`, och uppdaterar sedan grenen `master` för att referera till den nya incheckningen `d`. `HEAD` refererar fortfarande till grenen `master` och refererar därför nu indirekt till incheckning `d`:"

#. type: delimited block -
#: en/git-checkout.adoc:399 en/git-checkout.adoc:434 en/git-checkout.adoc:451
#, no-wrap, priority:240
msgid "$ edit; git add; git commit\n"
msgstr "$ edit; git add; git commit\n"

#. type: delimited block -
#: en/git-checkout.adoc:407
#, no-wrap, placeholders:'a---b---c---d', priority:240
msgid ""
"               HEAD (refers to branch 'master')\n"
"                |\n"
"                v\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""
"               HEAD (hänvisar till gren 'master')\n"
"                |\n"
"                v\n"
"a---b---c---d  gren 'master' (hänvisar till incheckning 'd')\n"
"    ^\n"
"    |\n"
"  tagg 'v2.0' (hänvisar till incheckning 'b')\n"

#. type: Plain text
#: en/git-checkout.adoc:413
#, priority:240
msgid "It is sometimes useful to be able to checkout a commit that is not at the tip of any named branch, or even to create a new commit that is not referenced by a named branch. Let's look at what happens when we checkout commit `b` (here we show two ways this may be done):"
msgstr "Det är ibland användbart att kunna checka ut en incheckning som inte finns i toppen av någon namngiven gren, eller till och med att skapa en ny incheckning som inte refereras av en namngiven gren. Låt oss titta på vad som händer när vi checkar ut incheckning `b` (här visar vi två sätt detta kan göras):"

#. type: delimited block -
#: en/git-checkout.adoc:417
#, no-wrap, priority:240
msgid ""
"$ git checkout v2.0  # or\n"
"$ git checkout master^^\n"
msgstr ""
"$ git checkout v2.0  # eller\n"
"$ git checkout master^^\n"

#. type: delimited block -
#: en/git-checkout.adoc:425
#, no-wrap, placeholders:'a---b---c---d', priority:240
msgid ""
"   HEAD (refers to commit 'b')\n"
"    |\n"
"    v\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""
"   HEAD (hänvisar till incheckning 'b')\n"
"    |\n"
"    v\n"
"a---b---c---d  gren 'master' (hänvisar till incheckning 'd')\n"
"    ^\n"
"    |\n"
"  tagg 'v2.0' (hänvisar till incheckning 'b')\n"

#. type: Plain text
#: en/git-checkout.adoc:431
#, placeholders:'`HEAD`':'`HEAD`':'`HEAD`', priority:240
msgid "Notice that regardless of which checkout command we use, `HEAD` now refers directly to commit `b`. This is known as being in detached `HEAD` state. It means simply that `HEAD` refers to a specific commit, as opposed to referring to a named branch. Let's see what happens when we create a commit:"
msgstr "Observera att oavsett vilket checkout-kommando vi använder, refererar `HEAD` nu direkt till incheckning `b`. Detta kallas att vara i frånkopplat `HEAD`-tillstånd. Det betyder helt enkelt att `HEAD` refererar till en specifik incheckning, i motsats till att referera till en namngiven gren. Låt oss se vad som händer när vi skapar en incheckning:"

#. type: delimited block -
#: en/git-checkout.adoc:444
#, no-wrap, placeholders:'a---b---c---d', priority:240
msgid ""
"     HEAD (refers to commit 'e')\n"
"      |\n"
"      v\n"
"      e\n"
"     /\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""
"     HEAD (hänvisar till incheckning 'e')\n"
"      |\n"
"      v\n"
"      e\n"
"     /\n"
"a---b---c---d  gren 'master' (hänvisar till incheckning 'd')\n"
"    ^\n"
"    |\n"
"  tagg 'v2.0' (hänvisar till incheckning 'b')\n"

#. type: Plain text
#: en/git-checkout.adoc:448
#, placeholders:'`HEAD`', priority:240
msgid "There is now a new commit `e`, but it is referenced only by `HEAD`. We can of course add yet another commit in this state:"
msgstr "Det finns nu en ny incheckning `e`, men den refereras endast av `HEAD`. Vi kan naturligtvis lägga till ytterligare en incheckning i detta tillstånd:"

#. type: delimited block -
#: en/git-checkout.adoc:461
#, no-wrap, placeholders:'e---f':'a---b---c---d', priority:240
msgid ""
"\t HEAD (refers to commit 'f')\n"
"\t  |\n"
"\t  v\n"
"      e---f\n"
"     /\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""
"\t HEAD (hänvisar till incheckning 'f')\n"
"\t  |\n"
"\t  v\n"
"      e---f\n"
"     /\n"
"a---b---c---d  gren 'master' (hänvisar till incheckning 'd')\n"
"    ^\n"
"    |\n"
"  tagg 'v2.0' (hänvisar till incheckning 'b')\n"

#. type: Plain text
#: en/git-checkout.adoc:465
#, priority:240
msgid "In fact, we can perform all the normal Git operations. But, let's look at what happens when we then checkout `master`:"
msgstr "Faktum är att vi kan utföra alla vanliga Git-operationer. Men låt oss titta på vad som händer när vi sedan checkar ut `master`:"

#. type: delimited block -
#: en/git-checkout.adoc:468
#, no-wrap, priority:240
msgid "$ git checkout master\n"
msgstr "$ git checkout master\n"

#. type: delimited block -
#: en/git-checkout.adoc:476
#, no-wrap, placeholders:'e---f':'a---b---c---d', priority:240
msgid ""
"               HEAD (refers to branch 'master')\n"
"      e---f     |\n"
"     /          v\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""
"               HEAD (hänvisar till gren 'master')\n"
"      e---f     |\n"
"     /          v\n"
"a---b---c---d  gren 'master' (refers to incheckning 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (hänvisar till incheckning 'b')\n"

#. type: Plain text
#: en/git-checkout.adoc:483
#, priority:240
msgid "It is important to realize that at this point nothing refers to commit `f`. Eventually commit `f` (and by extension commit `e`) will be deleted by the routine Git garbage collection process, unless we create a reference before that happens. If we have not yet moved away from commit `f`, any of these will create a reference to it:"
msgstr "Det är viktigt att inse att ingenting i nuläget refererar till incheckning `f`. Så småningom kommer incheckning `f` (och i förlängningen incheckning `e`) att raderas av Gits rutinmässiga skräpinsamlingsprocess, såvida vi inte skapar en referens innan det händer. Om vi inte ännu har gått ifrån incheckning `f` kommer någon av dessa att skapa en referens till den:"

#. type: delimited block -
#: en/git-checkout.adoc:488
#, no-wrap, priority:240
msgid ""
"$ git checkout -b foo  # or \"git switch -c foo\"  <1>\n"
"$ git branch foo                                 <2>\n"
"$ git tag foo                                    <3>\n"
msgstr ""
"$ git checkout -b foo  # eller \"git switch -c foo\"  <1>\n"
"$ git branch foo                                 <2>\n"
"$ git tag foo                                    <3>\n"

#. type: Plain text
#: en/git-checkout.adoc:492
#, placeholders:'`HEAD`':'`HEAD`', priority:240
msgid "creates a new branch `foo`, which refers to commit `f`, and then updates `HEAD` to refer to branch `foo`. In other words, we'll no longer be in detached `HEAD` state after this command."
msgstr "skapar en ny gren `foo`, som refererar till incheckning `f`, och uppdaterar sedan `HEAD` för att referera till grenen `foo`. Med andra ord, vi kommer inte längre att vara i frånkopplat-`HEAD` läge efter detta kommando."

#. type: Plain text
#: en/git-checkout.adoc:494
#, placeholders:'`HEAD`', priority:240
msgid "similarly creates a new branch `foo`, which refers to commit `f`, but leaves `HEAD` detached."
msgstr "på liknande sätt skapar man en ny gren `foo`, som refererar till incheckning `f`, men lämnar `HEAD` fristående."

#. type: Plain text
#: en/git-checkout.adoc:496
#, placeholders:'`HEAD`', priority:240
msgid "creates a new tag `foo`, which refers to commit `f`, leaving `HEAD` detached."
msgstr "skapar en ny tagg `foo`, som refererar till incheckning `f`, och lämnar `HEAD` frånkopplat."

#. type: Plain text
#: en/git-checkout.adoc:501
#, placeholders:'`HEAD`', priority:240
msgid "If we have moved away from commit `f`, then we must first recover its object name (typically by using git reflog), and then we can create a reference to it. For example, to see the last two commits to which `HEAD` referred, we can use either of these commands:"
msgstr "Om vi har gått ifrån incheckning `f` måste vi först återställa dess objektnamn (vanligtvis med hjälp av git reflog), och sedan kan vi skapa en referens till det. För att till exempel se de två sista incheckningarna som `HEAD` refererade till kan vi använda något av dessa kommandon:"

#. type: delimited block -
#: en/git-checkout.adoc:505
#, no-wrap, priority:240
msgid ""
"$ git reflog -2 HEAD # or\n"
"$ git log -g -2 HEAD\n"
msgstr ""
"$ git reflog -2 HEAD # eller\n"
"$ git log -g -2 HEAD\n"

#. type: Title -
#: en/git-checkout.adoc:508
#, no-wrap, priority:240
msgid "ARGUMENT DISAMBIGUATION"
msgstr "ARGUMENT SÄRSKILJNING"

#. type: Plain text
#: en/git-checkout.adoc:514
#, priority:240
msgid "When you run `git checkout <something>`, Git tries to guess whether _<something>_ is intended to be a branch, a commit, or a set of file(s), and then either switches to that branch or commit, or restores the specified files."
msgstr "När du kör `git checkout <något>` försöker Git gissa om _<något>_ är avsedd att vara en gren, en incheckning eller en uppsättning filer, och växlar sedan antingen till den grenen eller incheckningen, eller återställer de angivna filerna."

#. type: Plain text
#: en/git-checkout.adoc:518
#, priority:240
msgid "If there's any ambiguity, Git will treat `<something>` as a branch or commit, but you can use the double dash `--` to force Git to treat the parameter as a list of files and/or directories, like this:"
msgstr "Om det finns någon tvetydighet kommer Git att behandla `<något>` som en gren eller incheckning, men du kan använda det dubbla bindestrecket `--` för att tvinga Git att behandla parametern som en lista med filer och/eller kataloger, så här:"

#. type: delimited block -
#: en/git-checkout.adoc:521
#, no-wrap, priority:240
msgid "git checkout -- file.txt\n"
msgstr "git checkout -- fil.txt\n"

#. type: Title ===
#: en/git-checkout.adoc:526
#, no-wrap, priority:240
msgid "1. Paths"
msgstr "1. Sökvägar"

#. type: Plain text
#: en/git-checkout.adoc:531
#, priority:240
msgid "The following sequence checks out the `master` branch, reverts the `Makefile` to two revisions back, deletes `hello.c` by mistake, and gets it back from the index."
msgstr "Följande sekvens kontrollerar grenen `master`, återställer `Makefile` till två versioner bakåt, tar bort `hello.c` av misstag och hämtar tillbaka den från indexet."

#. type: delimited block -
#: en/git-checkout.adoc:537
#, no-wrap, priority:240
msgid ""
"$ git checkout master             <1>\n"
"$ git checkout master~2 Makefile  <2>\n"
"$ rm -f hello.c\n"
"$ git checkout hello.c            <3>\n"
msgstr ""
"$ git checkout master             <1>\n"
"$ git checkout master~2 Makefile  <2>\n"
"$ rm -f hello.c\n"
"$ git checkout hello.c            <3>\n"

#. type: Plain text
#: en/git-checkout.adoc:539
#, priority:240
msgid "switch branch"
msgstr "byt gren"

#. type: Plain text
#: en/git-checkout.adoc:544
#, priority:240
msgid "If you want to check out _all_ C source files out of the index, you can say"
msgstr "Om du vill checka ut _alla_ C-källkods-filer från indexet kan du säga"

#. type: delimited block -
#: en/git-checkout.adoc:547
#, no-wrap, priority:240
msgid "$ git checkout -- '*.c'\n"
msgstr "$ git checkout -- '*.c'\n"

#. type: Plain text
#: en/git-checkout.adoc:553
#, priority:240
msgid "Note the quotes around `*.c`. The file `hello.c` will also be checked out, even though it is no longer in the working tree, because the file globbing is used to match entries in the index (not in the working tree by the shell)."
msgstr "Observera citattecknen runt `*.c`. Filen `hello.c` kommer också att checkas ut, även om den inte längre finns i arbetsträdet, eftersom filglobbing används för att matcha poster i indexet (inte i arbetsträdet av skalet)."

#. type: Plain text
#: en/git-checkout.adoc:557
#, priority:240
msgid "If you have an unfortunate branch that is named `hello.c`, this step would be confused as an instruction to switch to that branch. You should instead write:"
msgstr "Om du har en olycklig gren som heter `hello.c`, skulle detta steg förväxlas med en instruktion för att byta till den grenen. Du bör i stället skriva:"

#. type: delimited block -
#: en/git-checkout.adoc:560
#, no-wrap, priority:240
msgid "$ git checkout -- hello.c\n"
msgstr "$ git checkout -- hello.c\n"

#. type: Title ===
#: en/git-checkout.adoc:562
#, no-wrap, priority:240
msgid "2. Merge"
msgstr "2. Sammanslagning"

#. type: delimited block -
#: en/git-checkout.adoc:569
#, no-wrap, priority:240
msgid "$ git checkout mytopic\n"
msgstr "$ git checkout mittämne\n"

#. type: Plain text
#: en/git-checkout.adoc:574
#, priority:240
msgid "However, your \"wrong\" branch and correct `mytopic` branch may differ in files that you have modified locally, in which case the above checkout would fail like this:"
msgstr "Din \"felaktiga\" gren och korrekta `mittämne`-gren kan dock skilja sig åt i filer som du har modifierat lokalt, i vilket fall utcheckningen ovan skulle misslyckas så här:"

#. type: delimited block -
#: en/git-checkout.adoc:578
#, no-wrap, priority:240
msgid ""
"$ git checkout mytopic\n"
"error: You have local changes to 'frotz'; not switching branches.\n"
msgstr ""
"$ git checkout mittämne\n"
"error: You have local changes to 'frotz'; not switching branches.\n"

#. type: Plain text
#: en/git-checkout.adoc:582
#, fuzzy, placeholders:'`-m`', priority:240
#| msgid "You can give the `-m` flag to the command, which would try a three-way merge:"
msgid "You can give the `-m` flag to the command, which will carry your local changes to the new branch:"
msgstr "Du kan ge flaggan `-m` till kommandot, vilket skulle försöka en trevägssammanslagning:"

#. type: delimited block -
#: en/git-checkout.adoc:589
#, no-wrap, priority:240
msgid ""
"$ git checkout -m mytopic\n"
"Applied autostash.\n"
"Switched to branch 'mytopic'\n"
"The following paths have local changes:\n"
"M\tfrotz\n"
msgstr ""

#. type: Plain text
#: en/git-checkout.adoc:594
#, fuzzy, priority:240
#| msgid "After this three-way merge, the local modifications are _not_ registered in your index file, so `git diff` would show you what changes you made since the tip of the new branch."
msgid "After the switch, the local modifications are reapplied and are _not_ registered in your index file, so `git diff` would show you what changes you made since the tip of the new branch."
msgstr "Efter denna trevägssammanslagning registreras de lokala modifieringarna _inte_ i din indexfil, så `git diff` skulle visa dig vilka ändringar du gjort sedan starten av den nya grenen."

#. type: Title ===
#: en/git-checkout.adoc:595
#, no-wrap, priority:240
msgid "3. Merge conflict"
msgstr "3. Sammanslagningskonflikt"

#. type: Plain text
#: en/git-checkout.adoc:602
#, placeholders:'`--merge`':'`-m`', priority:240
msgid "When the `--merge` (`-m`) option is given and the local changes overlap with the changes in the branch we're switching to, the changes are stashed and reapplied after the switch. If this process results in conflicts, the stash entry is saved and a message is printed:"
msgstr ""

#. type: delimited block -
#: en/git-checkout.adoc:610
#, no-wrap, placeholders:'--hard', priority:240
msgid ""
"$ git checkout -m mytopic\n"
"Your local changes are stashed, however applying them\n"
"resulted in conflicts.  You can either resolve the conflicts\n"
"and then discard the stash with \"git stash drop\", or, if you\n"
"do not want to resolve them now, run \"git reset --hard\" and\n"
"apply the local changes later by running \"git stash pop\".\n"
msgstr ""

#. type: Plain text
#: en/git-checkout.adoc:623
#, ignore-same, priority:240
msgid "linkgit:git-switch[1], linkgit:git-restore[1]"
msgstr "linkgit:git-switch[1], linkgit:git-restore[1]"

#. type: Title =
#: en/git-patch-id.adoc:2
#, ignore-same, no-wrap, priority:80
msgid "git-patch-id(1)"
msgstr "git-patch-id(1)"

#. type: Plain text
#: en/git-patch-id.adoc:7
#, fuzzy, placeholders:'git-patch-id', priority:80
#| msgid "git-patch-id - Compute unique ID for a patch"
msgid "git-patch-id - Compute unique IDs for patches"
msgstr "git-patch-id - Beräkna unikt ID för en patch"

#. type: synopsis
#: en/git-patch-id.adoc:12
#, no-wrap, placeholders:'git patch-id':'[--stable':'--unstable':'--verbatim]', priority:80
msgid "git patch-id [--stable | --unstable | --verbatim]\n"
msgstr "git patch-id [--stable | --unstable | --verbatim]\n"

#. type: Plain text
#: en/git-patch-id.adoc:16
#, fuzzy, priority:80
#| msgid "Read a patch from the standard input and compute the patch ID for it."
msgid "Read patches from standard input and compute the patch IDs."
msgstr "Läs en patch från standard-in och beräkna patch-ID:t för den."

#. type: Plain text
#: en/git-patch-id.adoc:21
#, priority:80
msgid "A \"patch ID\" is nothing but a sum of SHA-1 of the file diffs associated with a patch, with line numbers ignored. As such, it's \"reasonably stable\", but at the same time also reasonably unique, i.e., two patches that have the same \"patch ID\" are almost guaranteed to be the same thing."
msgstr "Ett \"patch-ID\" är inget annat än en summa av SHA-1 för fildifferenserna som är associerade med en patch, med radnummer ignorerade. Som sådan är det \"rimligt stabilt\", men samtidigt också rimligt unikt, d.v.s. två patchar som har samma \"patch-ID\" är nästan garanterat samma sak."

#. type: Plain text
#: en/git-patch-id.adoc:23
#, priority:80
msgid "The main usecase for this command is to look for likely duplicate commits."
msgstr "Det huvudsakliga användningsområdet för det här kommandot är att leta efter sannolika dubbletter av incheckningar."

#. type: Plain text
#: en/git-patch-id.adoc:30
#, fuzzy, placeholders:'git diff-tree':'--patch`', priority:80
#| msgid "When dealing with `git diff-tree` output, it takes advantage of the fact that the patch is prefixed with the object name of the commit, and outputs two 40-byte hexadecimal strings. The first string is the patch ID, and the second string is the commit ID. This can be used to make a mapping from patch ID to commit ID."
msgid "When dealing with `git diff-tree --patch` output, it takes advantage of the fact that the patch is prefixed with the object name of the commit, and outputs two 40-byte hexadecimal strings. The first string is the patch ID, and the second string is the commit ID. This can be used to make a mapping from patch ID to commit ID for a set or range of commits."
msgstr "När man hanterar `git diff-tree`-utdata utnyttjar den det faktum att patchen har prefixet med incheckningens objektnamn och matar ut två 40-byte hexadecimala strängar. Den första strängen är patch-ID:t och den andra strängen är inchecknings-ID:t. Detta kan användas för att göra en mappning från patch-ID till inchecknings-ID."

#. type: Labeled list
#: en/git-patch-id.adoc:34
#, ignore-same, no-wrap, priority:80
msgid "`--verbatim`"
msgstr "`--verbatim`"

#. type: Plain text
#: en/git-patch-id.adoc:37
#, fuzzy, placeholders:'`--stable`':'`--unstable`', priority:80
#| msgid "Calculate the patch-id of the input as it is given, do not strip any whitespace."
msgid "Calculate the patch ID of the input as it is given, do not strip any whitespace. Implies `--stable` and forbids `--unstable`."
msgstr "Beräkna patch-id för indata som det ges, ta inte bort något blanksteg."

#. type: Plain text
#: en/git-patch-id.adoc:39
#, placeholders:'patchid.verbatim', priority:80
msgid "This is the default if `patchid.verbatim` is `true`."
msgstr "Detta är standardvärdet om `patchid.verbatim` är `true`."

#. type: Labeled list
#: en/git-patch-id.adoc:40
#, ignore-same, no-wrap, priority:80
msgid "`--stable`"
msgstr "`--stable`"

#. type: Plain text
#: en/git-patch-id.adoc:42
#, priority:80
msgid "Use a \"stable\" sum of hashes as the patch ID. With this option:"
msgstr "Använd en \"stabil\" summa av hashvärden som patch-ID. Med det här alternativet:"

#. type: Plain text
#: en/git-patch-id.adoc:50
#, fuzzy, priority:80
#| msgid "Reordering file diffs that make up a patch does not affect the ID. In particular, two patches produced by comparing the same two trees with two different settings for `-O<orderfile>` result in the same patch ID signature, thereby allowing the computed result to be used as a key to index some meta-information about the change between the two trees;"
msgid "Reordering file diffs that make up a patch does not affect the ID. In particular, two patches produced by comparing the same two trees with two different settings for `-O<orderfile>` result in the same patch ID signature, thereby allowing the computed result to be used as a key to index some meta-information about the change between the two trees."
msgstr "Att ändra ordning på fildifferenser som utgör en patch påverkar inte ID:t. I synnerhet resulterar två patchar som produceras genom att jämföra samma två träd med två olika inställningar för `-O<orderfile>` i samma patch-ID-signatur, vilket gör att det beräknade resultatet kan användas som en nyckel för att indexera viss metainformation om förändringen mellan de två träden;"

#. type: Plain text
#: en/git-patch-id.adoc:56
#, fuzzy, placeholders:'`--unstable`', priority:80
#| msgid "Result is different from the value produced by git 1.9 and older or produced when an \"unstable\" hash (see `--unstable` below) is configured - even when used on a diff output taken without any use of `-O<orderfile>`, thereby making existing databases storing such \"unstable\" or historical patch-ids unusable."
msgid "The result is different from the value produced by Git 1.9 and older or produced when an \"unstable\" hash (see `--unstable` below) is configured - even when used on a diff output taken without any use of `-O<orderfile>`, thereby making existing databases storing such \"unstable\" or historical patch IDs unusable."
msgstr "Resultatet skiljer sig från värdet som produceras av git 1.9 och äldre eller produceras när en \"instabil\" hash (se `--unstable` nedan) konfigureras - även när den används på en diff-utdata som tas utan användning av `-O<orderfile>`, vilket gör befintliga databaser som lagrar sådana \"instabila\" eller historiska patch-id:n oanvändbara."

#. type: Plain text
#: en/git-patch-id.adoc:58
#, fuzzy, priority:80
#| msgid "All whitespace within the patch is ignored and does not affect the id."
msgid "All whitespace within the patch is ignored and does not affect the ID."
msgstr "Allt blanktecken i patchen ignoreras och påverkar inte id:t."

#. type: Plain text
#: en/git-patch-id.adoc:61
#, placeholders:'patchid.stable', priority:80
msgid "This is the default if `patchid.stable` is set to `true`."
msgstr "Detta är standardvärdet om `patchid.stable` är satt till `true`."

#. type: Labeled list
#: en/git-patch-id.adoc:62
#, ignore-same, no-wrap, priority:80
msgid "`--unstable`"
msgstr "`--unstable`"

#. type: Plain text
#: en/git-patch-id.adoc:68
#, fuzzy, priority:80
#| msgid "Use an \"unstable\" hash as the patch ID. With this option, the result produced is compatible with the patch-id value produced by git 1.9 and older and whitespace is ignored. Users with pre-existing databases storing patch-ids produced by git 1.9 and older (who do not deal with reordered patches) may want to use this option."
msgid "Use an \"unstable\" hash as the patch ID. With this option, the result produced is compatible with the patch ID value produced by Git 1.9 and older and whitespace is ignored. Users with pre-existing databases storing patch IDs produced by Git 1.9 and older (who do not deal with reordered patches) may want to use this option."
msgstr "Använd en \"instabil\" hash som patch-ID. Med det här alternativet är resultatet kompatibelt med patch-id-värdet som produceras av git 1.9 och äldre, och blanksteg ignoreras. Användare med befintliga databaser som lagrar patch-id:n som produceras av git 1.9 och äldre (som inte hanterar omordnade patchar) kanske vill använda det här alternativet."

#. type: Plain text
#: en/git-patch-id.adoc:70
#, priority:80
msgid "This is the default."
msgstr "Detta är standardvärdet."

#. type: Plain text
#: en/git-patch-id.adoc:79
#, placeholders:'linkgit:git-cherry[1]', priority:80
msgid "linkgit:git-cherry[1] shows what commits from a branch have patch ID equivalent commits in some upstream branch. But it only tells you whether such a commit exists or not. What if you wanted to know the relevant commits in the upstream? We can use this command to make a mapping between your branch and the upstream branch:"
msgstr ""

#. type: delimited block -
#: en/git-patch-id.adoc:96
#, no-wrap, placeholders:'$branch':'$limit':'tail_opts':'$limit':'$upstream':'--format=':'$upstream':'$branch':'tail_opts':'--since=':'$since':'$upstream':'for_branch':'$(mktemp)':'for_upstream':'$(mktemp)', priority:80
msgid ""
"upstream=\"$1\"\n"
"branch=\"$2\"\n"
"test -z \"$branch\" && branch=HEAD\n"
"limit=\"$3\"\n"
"if test -n \"$limit\"\n"
"then\n"
"    tail_opts=\"$limit\"..\"$upstream\"\n"
"else\n"
"    since=$(git log --format=%aI \"$upstream\"..\"$branch\" | tail -1)\n"
"    tail_opts=--since=\"$since\"' '\"$upstream\"\n"
"fi\n"
"for_branch=$(mktemp)\n"
"for_upstream=$(mktemp)\n"
msgstr ""

#. type: delimited block -
#: en/git-patch-id.adoc:106
#, no-wrap, placeholders:'git rev-list':'--no-merges':'$upstream':'$branch':'git diff-tree':'--patch':'--stdin':'git patch-id':'--stable':'$for_branch':'git rev-list':'--no-merges':'$tail_opts':'git diff-tree':'--patch':'--stdin':'git patch-id':'--stable':'$for_upstream':'$for_branch':'$for_upstream':'$for_branch':'$for_upstream', priority:80
msgid ""
"git rev-list --no-merges \"$upstream\"..\"$branch\" |\n"
"    git diff-tree --patch --stdin |\n"
"    git patch-id  --stable | sort >\"$for_branch\"\n"
"git rev-list --no-merges $tail_opts |\n"
"    git diff-tree --patch --stdin |\n"
"    git patch-id  --stable | sort >\"$for_upstream\"\n"
"join -a1 \"$for_branch\" \"$for_upstream\" | cut -d' ' -f2,3\n"
"rm \"$for_branch\"\n"
"rm \"$for_upstream\"\n"
msgstr ""

#. type: Plain text
#: en/git-patch-id.adoc:110
#, priority:80
msgid "Now the first column shows the commit from your branch and the second column shows the patch ID equivalent commit, if it exists."
msgstr ""

#. type: Title -
#: en/date-formats.adoc:2
#, no-wrap, priority:280
msgid "DATE FORMATS"
msgstr "DATUMFORMAT"

#. type: Plain text
#: en/date-formats.adoc:6
#, placeholders:'GIT_AUTHOR_DATE':'GIT_COMMITTER_DATE', priority:280
msgid "The `GIT_AUTHOR_DATE` and `GIT_COMMITTER_DATE` environment variables support the following date formats:"
msgstr "Miljövariablerna `GIT_AUTHOR_DATE` och `GIT_COMMITTER_DATE` stöder följande datumformat:"

#. type: Labeled list
#: en/date-formats.adoc:7
#, no-wrap, priority:280
msgid "Git internal format"
msgstr "Git internt format"

#. type: Plain text
#: en/date-formats.adoc:12
#, priority:280
msgid "It is `<unix-timestamp> <time-zone-offset>`, where `<unix-timestamp>` is the number of seconds since the UNIX epoch. `<time-zone-offset>` is a positive or negative offset from UTC. For example CET (which is 1 hour ahead of UTC) is `+0100`."
msgstr "Det är `<unix-timestamp> <time-zone-offset>`, där `<unix-timestamp>` är antalet sekunder sedan UNIX-epoken. `<time-zone-offset>` är en positiv eller negativ förskjutning från UTC. Till exempel är CET (som är 1 timme före UTC) `+0100`."

#. type: Plain text
#: en/date-formats.adoc:17
#, priority:280
msgid "It is safer to prepend the `<unix-timestamp>` with `@` (e.g., `@0 +0000`), which forces Git to interpret it as a raw timestamp. This is required for values less than 100,000,000 (which have fewer than 9 digits) to avoid confusion with other date formats like `YYYYMMDD`."
msgstr ""

#. type: Labeled list
#: en/date-formats.adoc:18
#, no-wrap, priority:280
msgid "RFC 2822"
msgstr "RFC 2822"

#. type: Plain text
#: en/date-formats.adoc:21
#, priority:280
msgid "The standard date format as described by RFC 2822, for example `Thu, 07 Apr 2005 22:13:13 +0200`."
msgstr "Standarddatumformatet som beskrivs av RFC 2822, till exempel `Tor, 07 Apr 2005 22:13:13 +0200`."

#. type: Labeled list
#: en/date-formats.adoc:22
#, no-wrap, priority:280
msgid "ISO 8601"
msgstr "ISO 8601"

#. type: Plain text
#: en/date-formats.adoc:28
#, priority:280
msgid "Time and date specified by the ISO 8601 standard, for example `2005-04-07T22:13:13`. The parser accepts a space instead of the `T` character as well. Fractional parts of a second will be ignored, for example `2005-04-07T22:13:13.019` will be treated as `2005-04-07T22:13:13`."
msgstr "Tid och datum som anges av ISO 8601-standarden, till exempel `2005-04-07T22:13:13`. Parsern accepterar även ett mellanslag i stället för tecknet `T`. Bråkdelar av en sekund kommer att ignoreras, till exempel `2005-04-07T22:13:13.019` kommer att behandlas som `2005-04-07T22:13:13`."

#. type: Plain text
#: en/date-formats.adoc:31
#, priority:280
msgid "In addition, the date part is accepted in the following formats: `YYYY.MM.DD`, `MM/DD/YYYY` and `DD.MM.YYYY`."
msgstr "Dessutom accepteras datumdelen i följande format: `ÅÅÅÅ.MM.DD`, `MM/DD/ÅÅÅÅ` och `DD.MM.ÅÅÅÅ`."

#. type: Plain text
#: en/date-formats.adoc:36
#, placeholders:'`--date`', priority:280
msgid "In addition to recognizing all date formats above, the `--date` option will also try to make sense of other, more human-centric date formats, such as relative dates like \"yesterday\" or \"last Friday at noon\"."
msgstr "Förutom att känna igen alla datumformat ovan, kommer alternativet `--date` också att försöka förstå andra, mer människocentrerade datumformat, såsom relativa datum som \"yesterday\" (igår) eller \"yesterday\" (förra fredagen vid middagstid)."

#. type: Title =
#: en/git-diff.adoc:2
#, ignore-same, no-wrap, priority:280
msgid "git-diff(1)"
msgstr "git-diff(1)"

#. type: Plain text
#: en/git-diff.adoc:7
#, placeholders:'git-diff', priority:280
msgid "git-diff - Show changes between commits, commit and working tree, etc"
msgstr "git-diff - Visa ändringar mellan incheckningar, incheckning och arbetsträdet, osv"

#. type: synopsis
#: en/git-diff.adoc:18
#, ignore-ellipsis, no-wrap, placeholders:'--cached':'[--merge-base]':'[--merge-base]':'--no-index', priority:280
msgid ""
"git diff [<options>] [<commit>] [--] [<path>...]\n"
"git diff [<options>] --cached [--merge-base] [<commit>] [--] [<path>...]\n"
"git diff [<options>] [--merge-base] <commit> [<commit>...] <commit> [--] [<path>...]\n"
"git diff [<options>] <commit>...<commit> [--] [<path>...]\n"
"git diff [<options>] <blob> <blob>\n"
"git diff [<options>] --no-index [--] <path> <path> [<pathspec>...]\n"
msgstr ""
"git diff [<flaggor>] [<incheckning>] [--] [<path>...]\n"
"git diff [<flaggor>] --cached [--merge-base] [<incheckning>] [--] [<path>...]\n"
"git diff [<flaggor>] [--merge-base] <commit> [<incheckning>...] <incheckning> [--] [<path>...]\n"
"git diff [<flaggor>] <incheckning>...<incheckning> [--] [<sökväg>...]\n"
"git diff [<flaggor>] <blob> <blob>\n"
"git diff [<flaggor>] --no-index [--] <path> <path> [<sökvägsmönster>...]\n"

#. type: Plain text
#: en/git-diff.adoc:25
#, priority:280
msgid "Show changes between the working tree and the index or a tree, changes between the index and a tree, changes between two trees, changes resulting from a merge, changes between two blob objects, or changes between two files on disk."
msgstr "Visa ändringar mellan arbetsträdet och indexet eller ett träd, ändringar mellan indexet och ett träd, ändringar mellan två träd, ändringar som är resultatet av en sammanslagning, ändringar mellan två blobobjekt eller ändringar mellan två filer på disken."

#. type: Labeled list
#: en/git-diff.adoc:26
#, ignore-ellipsis, no-wrap, priority:280
msgid "`git diff [<options>] [--] [<path>...]`"
msgstr "`git diff [<flaggor>] [--] [<sökväg>...]`"

#. type: Plain text
#: en/git-diff.adoc:33
#, placeholders:'linkgit:git-add[1]', priority:280
msgid "This form is to view the changes you made relative to the index (staging area for the next commit). In other words, the differences are what you _could_ tell Git to further add to the index but you still haven't. You can stage these changes by using linkgit:git-add[1]."
msgstr "Formen visar de ändringar som gjorts i förhållande till indexet (köområdet för nästa incheckning). Med andra ord är skillnaderna vad Git ytterligare _skulle kunna_ lägga till i indexet, men ännu inte har gjort. Dessa ändringar kan köas med linkgit:git-add[1]."

#. type: Labeled list
#: en/git-diff.adoc:34
#, ignore-ellipsis, no-wrap, placeholders:'--no-index', priority:280
msgid "`git diff [<options>] --no-index [--] <path> <path> [<pathspec>...]`"
msgstr "`git diff [<flaggor>] --no-index [--] <sökväg> <sökväg> [<sökvägsmönster>...]`"

#. type: Plain text
#: en/git-diff.adoc:46
#, placeholders:'`--no-index`':'`--exit-code`', priority:280
msgid "This form is to compare the given two paths on the filesystem. You can omit the `--no-index` option when running the command in a working tree controlled by Git and at least one of the paths points outside the working tree, or when running the command outside a working tree controlled by Git. This form implies `--exit-code`. If both paths point to directories, additional pathspecs may be provided. These will limit the files included in the difference. All such pathspecs must be relative as they apply to both sides of the diff."
msgstr "Formen jämför de två angivna sökvägarna i filsystemet. Alternativet `--no-index` kan utelämnas när kommandot körs i ett arbetsträd som hanteras av Git och minst en av sökvägarna pekar utanför arbetsträdet, eller när kommandot körs utanför ett arbetsträd som hanteras av Git. Formen innebär `--exit-code`. Om båda sökvägarna pekar på kataloger kan ytterligare sökvägsmönster anges. Dessa begränsar vilka filer som ingår i skillnaden. Alla sådana sökvägsmönster måste vara relativa eftersom de gäller för båda sidor av diffen."

#. type: Labeled list
#: en/git-diff.adoc:47
#, ignore-ellipsis, no-wrap, placeholders:'--cached':'[--merge-base]', priority:280
msgid "`git diff [<options>] --cached [--merge-base] [<commit>] [--] [<path>...]`"
msgstr "`git diff [<flaggor>] --cached [--merge-base] [<incheckning>] [--] [<sökväg>...]`"

#. type: Plain text
#: en/git-diff.adoc:56
#, placeholders:'`HEAD`':'`HEAD`':'`--staged`':'`--cached`', priority:280
msgid "This form is to view the changes you staged for the next commit relative to the named _<commit>_. Typically you would want comparison with the latest commit, so if you do not give _<commit>_, it defaults to `HEAD`. If `HEAD` does not exist (e.g. unborn branches) and _<commit>_ is not given, it shows all staged changes. `--staged` is a synonym of `--cached`."
msgstr "Formen visar de ändringar som har köats för nästa incheckning i förhållande till den namngivna _<incheckningen>_. Vanligtvis är det naturligt att jämföra med den senaste incheckningen, så om _<incheckning>_ inte anges används som standard `HEAD`. Om `HEAD` inte existerar (t.ex. ofödda grenar) och _<incheckning>_ inte anges, visas alla köade ändringar. `--staged` är en synonym för `--cached`."

#. type: Plain text
#: en/git-diff.adoc:60
#, placeholders:'`--merge-base`':'`HEAD`':'--cached':'--merge-base':'--cached':'git merge-base', priority:280
msgid "If `--merge-base` is given, instead of using _<commit>_, use the merge base of _<commit>_ and `HEAD`. `git diff --cached --merge-base A` is equivalent to `git diff --cached $(git merge-base A HEAD)`."
msgstr "Om `--merge-base` anges används sammanslagningsbasen för _<incheckning>_ och `HEAD` i stället för _<incheckning>_. `git diff --cached --merge-base A` motsvarar `git diff --cached $(git merge-base A HEAD)`."

#. type: Labeled list
#: en/git-diff.adoc:61
#, ignore-ellipsis, no-wrap, placeholders:'[--merge-base]', priority:280
msgid "`git diff [<options>] [--merge-base] <commit> [--] [<path>...]`"
msgstr "`git diff [<flaggor>] [--merge-base] <incheckning> [--] [<sökväg>...]`"

#. type: Plain text
#: en/git-diff.adoc:68
#, placeholders:'`HEAD`', priority:280
msgid "This form is to view the changes you have in your working tree relative to the named _<commit>_. You can use `HEAD` to compare it with the latest commit, or a branch name to compare with the tip of a different branch."
msgstr "Formen visar de ändringar som finns i arbetsträdet i förhållande till den namngivna _<incheckningen>_. `HEAD` kan användas för att jämföra med den senaste incheckningen, eller ett grennamn för att jämföra med toppen av en annan gren."

#. type: Plain text
#: en/git-diff.adoc:72
#, placeholders:'`--merge-base`':'`HEAD`':'--merge-base':'git merge-base', priority:280
msgid "If `--merge-base` is given, instead of using _<commit>_, use the merge base of _<commit>_ and `HEAD`. `git diff --merge-base A` is equivalent to `git diff $(git merge-base A HEAD)`."
msgstr "Om `--merge-base` anges används sammanslagningsbasen för _<incheckning>_ och `HEAD` i stället för _<incheckning>_. `git diff --merge-base A` motsvarar `git diff $(git merge-base A HEAD)`."

#. type: Labeled list
#: en/git-diff.adoc:73
#, ignore-ellipsis, no-wrap, placeholders:'[--merge-base]', priority:280
msgid "`git diff [<options>] [--merge-base] <commit> <commit> [--] [<path>...]`"
msgstr "`git diff [<flaggor>] [--merge-base] <incheckning> <incheckning> [--] [<sökväg>...]`"

#. type: Plain text
#: en/git-diff.adoc:77
#, priority:280
msgid "This is to view the changes between two arbitrary _<commit>_."
msgstr "Visar ändringarna mellan två godtyckliga _<incheckningar>_."

#. type: Plain text
#: en/git-diff.adoc:81
#, placeholders:'`--merge-base`':'--merge-base':'git merge-base', priority:280
msgid "If `--merge-base` is given, use the merge base of the two commits for the \"before\" side. `git diff --merge-base A B` is equivalent to `git diff $(git merge-base A B) B`."
msgstr "Om `--merge-base` anges används sammanslagningsbasen för de två incheckningarna på \"före\"-sidan. `git diff --merge-base A B` motsvarar `git diff $(git merge-base A B) B`."

#. type: Labeled list
#: en/git-diff.adoc:82
#, ignore-ellipsis, no-wrap, priority:280
msgid "`git diff [<options>] <commit> <commit>...<commit> [--] [<path>...]`"
msgstr "`git diff [<flaggor>] <incheckning> <incheckning>...<incheckning> [--] [<sökväg>...]`"

#. type: Plain text
#: en/git-diff.adoc:90
#, priority:280
msgid "This form is to view the results of a merge commit. The first listed _<commit>_ must be the merge itself; the remaining two or more commits should be its parents. Convenient ways to produce the desired set of revisions are to use the suffixes `@` and `^!`. If `A` is a merge commit, then `git diff A A^@`, `git diff A^!` and `git show A` all give the same combined diff."
msgstr "Formen visar resultatet av en sammanslagningsincheckning. Den första listade _<incheckning>_ måste vara själva sammanslagningen; de återstående två eller fler incheckningarna ska vara dess föräldrar. Ett smidigt sätt att få fram önskad uppsättning revisioner är att använda suffixen `@` och `^!`. Om `A` är en sammanslagningsincheckning ger `git diff A A^@`, `git diff A^!` och `git show A` samma kombinerade diff."

#. type: Labeled list
#: en/git-diff.adoc:91
#, ignore-ellipsis, no-wrap, priority:280
msgid "`git diff [<options>] <commit>..<commit> [--] [<path>...]`"
msgstr "`git diff [<flaggor>] <incheckning>..<incheckning> [--] [<sökväg>...]`"

#. type: Plain text
#: en/git-diff.adoc:97
#, placeholders:'`HEAD`', priority:280
msgid "This is synonymous to the earlier form (without the `..`) for viewing the changes between two arbitrary _<commit>_. If _<commit>_ on one side is omitted, it will have the same effect as using `HEAD` instead."
msgstr "Detta är synonymt med den tidigare formen (utan `..`) för att visa ändringarna mellan två godtyckliga _<incheckningar>_. Om _<incheckning>_ på ena sidan utelämnas, har det samma effekt som att använda `HEAD` i stället."

#. type: Labeled list
#: en/git-diff.adoc:98
#, ignore-ellipsis, no-wrap, priority:280
msgid "`git diff [<options>] <commit>...<commit> [--] [<path>...]`"
msgstr "`git diff [<flaggor>] <incheckning>..<incheckning> [--] [<sökväg>...]`"

#. type: Plain text
#: en/git-diff.adoc:105
#, ignore-ellipsis, placeholders:'git merge-base':'`HEAD`', priority:280
msgid "This form is to view the changes on the branch containing and up to the second _<commit>_, starting at a common ancestor of both _<commit>_. `git diff A...B` is equivalent to `git diff $(git merge-base A B) B`. You can omit any one of _<commit>_, which has the same effect as using `HEAD` instead."
msgstr "Formen visar ändringarna på grenen som innehåller och sträcker sig fram till den andra _<incheckningen>_, med början vid en gemensam förfader till båda _<incheckningarna>_. `git diff A...B` motsvarar `git diff $(git merge-base A B) B`. Man kan utelämna vilken som helst av _<incheckningarna>_, vilket har samma effekt som att använda `HEAD` i stället."

#. type: Plain text
#: en/git-diff.adoc:114
#, placeholders:'`--merge-base`':'AUTO_MERGE':'linkgit:git-merge[1]':'AUTO_MERGE', priority:280
msgid "Just in case you are doing something exotic, it should be noted that all of the _<commit>_ in the above description, except in the `--merge-base` case and in the last two forms that use `..` notations, can be any _<tree>_. A tree of interest is the one pointed to by the ref named `AUTO_MERGE`, which is written by the `ort` merge strategy upon hitting merge conflicts (see linkgit:git-merge[1]). Comparing the working tree with `AUTO_MERGE` shows changes you've made so far to resolve textual conflicts (see the examples below)."
msgstr "Om något mer ovanligt görs bör det noteras att alla _<incheckningar>_ i beskrivningen ovan, förutom i fallet `--merge-base` och i de två sista formerna som använder `..`-notationerna, kan vara vilket _<träd>_ som helst. Ett intressant träd är det som pekas ut av referensen med namnet `AUTO_MERGE`, som skrivs av `ort`-sammanslagningsstrategin vid sammanslagningskonflikter (se linkgit:git-merge[1]). Att jämföra arbetsträdet med `AUTO_MERGE` visar ändringar som hittills har gjorts för att lösa textkonflikter (se exemplen nedan)."

#. type: Plain text
#: en/git-diff.adoc:121
#, ignore-ellipsis, placeholders:'linkgit:gitrevisions[7]':'linkgit:gitrevisions[7]', priority:280
msgid "For a more complete list of ways to spell _<commit>_, see \"SPECIFYING REVISIONS\" section in linkgit:gitrevisions[7]. However, `diff` is about comparing two _endpoints_, not ranges, and the range notations (`<commit>..<commit>` and `<commit>...<commit>`) do not mean a range as defined in the \"SPECIFYING RANGES\" section in linkgit:gitrevisions[7]."
msgstr "För en mer fullständig lista över sätt att ange _<incheckning>_, se avsnittet \"SPECIFYING REVISIONS\" i linkgit:gitrevisions[7]. Observera dock att `diff` handlar om att jämföra två _slutpunkter_, inte intervall, och att intervallnotationerna (`<incheckning>..<incheckning>` och `<incheckning>...<incheckning>`) inte betyder ett intervall i den mening som definieras i avsnittet \"SPECIFYING RANGES\" i linkgit:gitrevisions[7]."

#. type: Labeled list
#: en/git-diff.adoc:122
#, no-wrap, priority:280
msgid "`git diff [<options>] <blob> <blob>`"
msgstr "`git diff [<flaggor>] <blob> <blob>`"

#. type: Plain text
#: en/git-diff.adoc:126
#, priority:280
msgid "This form is to view the differences between the raw contents of two blob objects."
msgstr "Formen visar skillnaderna mellan det råa innehållet i två blob-objekt."

#. type: Labeled list
#: en/git-diff.adoc:132
#, ignore-same, no-wrap, priority:280
msgid "`-1`"
msgstr "`-1`"

#. type: Labeled list
#: en/git-diff.adoc:133
#, ignore-same, no-wrap, priority:280
msgid "`--base`"
msgstr "`--base`"

#. type: Labeled list
#: en/git-diff.adoc:134
#, ignore-same, no-wrap, priority:280
msgid "`-2`"
msgstr "`-2`"

#. type: Labeled list
#: en/git-diff.adoc:136
#, ignore-same, no-wrap, priority:280
msgid "`-3`"
msgstr "`-3`"

#. type: Plain text
#: en/git-diff.adoc:139
#, priority:280
msgid "Compare the working tree with"
msgstr "Jämför arbetsträdet med"

#. type: Plain text
#: en/git-diff.adoc:142
#, placeholders:'`--base`', priority:280
msgid "the \"base\" version (stage #1) when using `-1` or `--base`,"
msgstr "\"basversionen\" (steg nr1) när `-1` eller `--base` används,"

#. type: Plain text
#: en/git-diff.adoc:143
#, placeholders:'`--ours`', priority:280
msgid "\"our branch\" (stage #2) when using `-2` or `--ours`, or"
msgstr "\"vår gren\" (steg nr 2) när `-2` eller `--ours` används, eller"

#. type: Plain text
#: en/git-diff.adoc:144
#, placeholders:'`--theirs`', priority:280
msgid "\"their branch\" (stage #3) when using `-3` or `--theirs`."
msgstr "\"deras gren\" (steg nr 3) när `-3` eller `--theirs` används."

#. type: Plain text
#: en/git-diff.adoc:149
#, placeholders:'linkgit:git-read-tree[1]', priority:280
msgid "The index contains these stages only for unmerged entries i.e. while resolving conflicts. See linkgit:git-read-tree[1] section \"3-Way Merge\" for detailed information."
msgstr "Indexet innehåller dessa steg bara för osammanslagna poster, d.v.s. vid konfliktlösning. Se avsnittet \"3-Way Merge\" i linkgit:git-read-tree[1] för detaljerad information."

#. type: Labeled list
#: en/git-diff.adoc:150
#, ignore-same, no-wrap, priority:280
msgid "`-0`"
msgstr "`-0`"

#. type: Plain text
#: en/git-diff.adoc:154
#, priority:280
msgid "Omit diff output for unmerged entries and just show \"Unmerged\". Can be used only when comparing the working tree with the index."
msgstr "Utelämna diff-utdata för ej sammanslagna poster och visa bara \"Osammanslagen\". Kan endast användas när arbetsträdet jämförs med indexet."

#. type: Plain text
#: en/git-diff.adoc:159
#, priority:280
msgid "The _<path>_ parameters, when given, are used to limit the diff to the named paths (you can give directory names and get diff for all files under them)."
msgstr "Parametrarna _<sökväg>_, när de är angivna, används för att begränsa differansen till de namngivna sökvägarna (du kan ange katalognamn och hämta diff-värden för alla filer under dem)."

#. type: Labeled list
#: en/git-diff.adoc:166
#, no-wrap, priority:280
msgid "Various ways to check your working tree"
msgstr "Olika sätt att kontrollera arbetsträdet"

#. type: delimited block -
#: en/git-diff.adoc:173
#, no-wrap, placeholders:'--cached':'AUTO_MERGE', priority:280
msgid ""
"$ git diff            <1>\n"
"$ git diff --cached   <2>\n"
"$ git diff HEAD       <3>\n"
"$ git diff AUTO_MERGE <4>\n"
msgstr ""
"$ git diff            <1>\n"
"$ git diff --cached   <2>\n"
"$ git diff HEAD       <3>\n"
"$ git diff AUTO_MERGE <4>\n"

#. type: Plain text
#: en/git-diff.adoc:176
#, priority:280
msgid "Changes in the working tree not yet staged for the next commit."
msgstr "Ändringar i arbetsträdet är ännu inte köade för nästa incheckning."

#. type: Plain text
#: en/git-diff.adoc:178
#, placeholders:'`-a`', priority:280
msgid "Changes between the index and your last commit; what you would be committing if you run `git commit` without `-a` option."
msgstr "Ändringar mellan indexet och den senaste incheckningen; vad som skulle checkas in om `git commit` körs utan `-a`-flaggan."

#. type: Plain text
#: en/git-diff.adoc:180
#, priority:280
msgid "Changes in the working tree since your last commit; what you would be committing if you run `git commit -a`"
msgstr "Ändringar i arbetsträdet sedan den senaste incheckningen; vad som skulle checkas in om `git commit -a` körs"

#. type: Plain text
#: en/git-diff.adoc:182
#, priority:280
msgid "Changes in the working tree you've made to resolve textual conflicts so far."
msgstr "Ändringar i arbetsträdet som hittills har gjorts för att lösa textkonflikter."

#. type: Labeled list
#: en/git-diff.adoc:183
#, no-wrap, priority:280
msgid "Comparing with arbitrary commits"
msgstr "Jämförelse med godtyckliga incheckningar"

#. type: delimited block -
#: en/git-diff.adoc:189
#, no-wrap, priority:280
msgid ""
"$ git diff test            <1>\n"
"$ git diff HEAD -- ./test  <2>\n"
"$ git diff HEAD^ HEAD      <3>\n"
msgstr ""
"$ git diff test            <1>\n"
"$ git diff HEAD -- ./test  <2>\n"
"$ git diff HEAD^ HEAD      <3>\n"

#. type: Plain text
#: en/git-diff.adoc:193
#, priority:280
msgid "Instead of using the tip of the current branch, compare with the tip of \"test\" branch."
msgstr "I stället för att använda toppen på den aktuella grenen, jämför med toppen på \"test\"-grenen."

#. type: Plain text
#: en/git-diff.adoc:196
#, priority:280
msgid "Instead of comparing with the tip of \"test\" branch, compare with the tip of the current branch, but limit the comparison to the file \"test\"."
msgstr "I stället för att jämföra med toppen på grenen \"test\", jämför med toppen på den aktuella grenen, men begränsa jämförelsen till filen \"test\"."

#. type: Plain text
#: en/git-diff.adoc:197
#, priority:280
msgid "Compare the version before the last commit and the last commit."
msgstr "Jämför versionen före den senaste incheckningen och den senaste incheckningen."

#. type: Labeled list
#: en/git-diff.adoc:198
#, no-wrap, priority:280
msgid "Comparing branches"
msgstr "Jämföra grenar"

#. type: delimited block -
#: en/git-diff.adoc:204
#, ignore-ellipsis, no-wrap, priority:280
msgid ""
"$ git diff topic master    <1>\n"
"$ git diff topic..master   <2>\n"
"$ git diff topic...master  <3>\n"
msgstr ""
"$ git diff ärende master    <1>\n"
"$ git diff ärende..master   <2>\n"
"$ git diff ärende...master  <3>\n"

#. type: Plain text
#: en/git-diff.adoc:207
#, priority:280
msgid "Changes between the tips of the topic and the master branches."
msgstr "Ändringar mellan ämnets toppar och huvudgrenarna."

#. type: Plain text
#: en/git-diff.adoc:210
#, priority:280
msgid "Changes that occurred on the master branch since when the topic branch was started off it."
msgstr "Ändringar som inträffat på huvudgrenen sedan när ämnesgrenen startades från den."

#. type: Labeled list
#: en/git-diff.adoc:211
#, no-wrap, priority:280
msgid "Limiting the diff output"
msgstr "Begränsa diff-utmatning"

#. type: delimited block -
#: en/git-diff.adoc:217
#, no-wrap, placeholders:'--diff-filter=MRC':'--name-status', priority:280
msgid ""
"$ git diff --diff-filter=MRC            <1>\n"
"$ git diff --name-status                <2>\n"
"$ git diff arch/i386 include/asm-i386   <3>\n"
msgstr ""
"$ git diff --diff-filter=MRC            <1>\n"
"$ git diff --name-status                <2>\n"
"$ git diff arch/i386 include/asm-i386   <3>\n"

#. type: Plain text
#: en/git-diff.adoc:221
#, priority:280
msgid "Show only modification, rename, and copy, but not addition or deletion."
msgstr "Visa endast ändring, namnbyte och kopiering, men inte tillägg eller borttagning."

#. type: Plain text
#: en/git-diff.adoc:223
#, priority:280
msgid "Show only names and the nature of change, but not actual diff output."
msgstr "Visar endast namn och ändringens natur, men inte faktisk skillnadsutdata."

#. type: Plain text
#: en/git-diff.adoc:224
#, priority:280
msgid "Limit diff output to named subtrees."
msgstr "Begränsa diff-utdata till namngivna underträd."

#. type: Labeled list
#: en/git-diff.adoc:225
#, no-wrap, priority:280
msgid "Munging the diff output"
msgstr "Omformning av diff-utdata"

#. type: delimited block -
#: en/git-diff.adoc:230
#, no-wrap, placeholders:'--find-copies-harder', priority:280
msgid ""
"$ git diff --find-copies-harder -B -C  <1>\n"
"$ git diff -R                          <2>\n"
msgstr ""
"$ git diff --find-copies-harder -B -C  <1>\n"
"$ git diff -R                          <2>\n"

#. type: Plain text
#: en/git-diff.adoc:234
#, priority:280
msgid "Spend extra cycles to find renames, copies and complete rewrites (very expensive)."
msgstr "Lägg extra cykler på att hitta namnbyten, kopior och fullständiga omskrivningar (väldigt dyrt)."

#. type: Plain text
#: en/git-diff.adoc:235
#, priority:280
msgid "Output diff in reverse."
msgstr "Utgångsskillnad i omvänd ordning."

#. type: Plain text
#: en/git-diff.adoc:253
#, placeholders:'linkgit:git-difftool[1]':'linkgit:git-log[1]':'linkgit:gitdiffcore[7]':'linkgit:git-format-patch[1]':'linkgit:git-apply[1]':'linkgit:git-show[1]', priority:280
msgid "`diff`(1), linkgit:git-difftool[1], linkgit:git-log[1], linkgit:gitdiffcore[7], linkgit:git-format-patch[1], linkgit:git-apply[1], linkgit:git-show[1]"
msgstr "`diff`(1), linkgit:git-difftool[1], linkgit:git-log[1], linkgit:gitdiffcore[7], linkgit:git-format-patch[1], linkgit:git-apply[1], linkgit:git-show[1]"

#. type: Labeled list
#: en/diff-algorithm-option.adoc:1
#, ignore-same, no-wrap, priority:280
msgid "`--diff-algorithm=(patience|minimal|histogram|myers)`"
msgstr "`--diff-algorithm=(patience|minimal|histogram|myers)`"

#. type: Plain text
#: en/diff-algorithm-option.adoc:3 en/config/diff.adoc:227
#, priority:280
msgid "Choose a diff algorithm. The variants are as follows:"
msgstr "Välj en diff-algoritm. Varianterna är följande:"

#. type: Labeled list
#: en/diff-algorithm-option.adoc:6 en/config/diff.adoc:230
#, ignore-same, no-wrap, priority:280
msgid "`myers`"
msgstr "`myers`"

#. type: Plain text
#: en/diff-algorithm-option.adoc:8 en/config/diff.adoc:232
#, priority:280
msgid "The basic greedy diff algorithm. Currently, this is the default."
msgstr "Den grundläggande giriga diff-algoritmen. För närvarande är detta standard."

#. type: Labeled list
#: en/diff-algorithm-option.adoc:8 en/config/diff.adoc:232
#, ignore-same, no-wrap, priority:280
msgid "`minimal`"
msgstr "`minimal`"

#. type: Plain text
#: en/diff-algorithm-option.adoc:11 en/diff-options.adoc:185 en/config/diff.adoc:235
#, priority:280
msgid "Spend extra time to make sure the smallest possible diff is produced."
msgstr "Lägg extra tid på att se till att minsta möjliga skillnad produceras."

#. type: Plain text
#: en/diff-algorithm-option.adoc:13 en/config/diff.adoc:237
#, priority:280
msgid "Use \"patience diff\" algorithm when generating patches."
msgstr "Använd algoritmen \"patience diff\" när du genererar patchar."

#. type: Plain text
#: en/diff-algorithm-option.adoc:16 en/config/diff.adoc:240
#, priority:280
msgid "This algorithm extends the patience algorithm to \"support low-occurrence common elements\"."
msgstr "Denna algoritm utökar tålamodsalgoritmen till att \"stödja vanliga element med låg förekomst\"."

#. type: Plain text
#: en/diff-algorithm-option.adoc:20
#, placeholders:'diff.algorithm':'`--diff-algorithm=default`', priority:280
msgid "For instance, if you configured the `diff.algorithm` variable to a non-default value and want to use the default one, then you have to use `--diff-algorithm=default` option."
msgstr "Om du till exempel, konfigurerade variabeln `diff.algorithm` till ett värde som inte är standard och vill använda standardvärdet, måste du använda alternativet `--diff-algorithm=default`."

