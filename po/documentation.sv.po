#, ignore-same, no-wrap, priority:90
msgid "%m"
msgstr "%m"

#. type: Plain text
#: en/git-cvsserver.adoc:304
#, priority:90
msgid "CVS module/Git head name"
msgstr "CVS-modul/Git-huvudnamn"

#. type: Labeled list
#: en/git-cvsserver.adoc:304
#, ignore-same, no-wrap, priority:90
msgid "%a"
msgstr "%a"

