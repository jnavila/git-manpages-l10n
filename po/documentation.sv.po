#. type: Title =
#: en/git-fmt-merge-msg.adoc:2
#, ignore-same, no-wrap, priority:10
msgid "git-fmt-merge-msg(1)"
msgstr "git-fmt-merge-msg(1)"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:7
#, placeholders:'git-fmt-merge-msg', priority:10
msgid "git-fmt-merge-msg - Produce a merge commit message"
msgstr "git-fmt-merge-msg - Skapa ett sammanslagningsincheckningsmeddelande"

#. type: verse
#: en/git-fmt-merge-msg.adoc:14
#, no-wrap, placeholders:'git fmt-merge-msg':'[--into-name':'[--log':'--no-log]':'git fmt-merge-msg':'[--log':'--no-log]', priority:10
msgid ""
"'git fmt-merge-msg' [-m <message>] [--into-name <branch>] [--log[=<n>] | --no-log]\n"
"'git fmt-merge-msg' [-m <message>] [--log[=<n>] | --no-log] -F <file>\n"
msgstr ""
"'git fmt-merge-msg' [-m <meddelande>] [--into-name <gren>] [--log[=<n>] | --no-log]\n"
"'git fmt-merge-msg' [-m <meddelande>] [--log[=<n>] | --no-log] -F <fil>\n"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:20
#, priority:10
msgid "Takes the list of merged objects on stdin and produces a suitable commit message to be used for the merge commit, usually to be passed as the '<merge-message>' argument of 'git merge'."
msgstr "Tar listan över sammanfogade objekt på stdin och producerar ett lämpligt incheckningsmeddelande som ska användas för sammanslagningsincheckningen, vanligtvis att skickas som argumentet '<sammanslagnings-meddelande>' för 'git merge'."

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:23
#, priority:10
msgid "This command is intended mostly for internal use by scripts automatically invoking 'git merge'."
msgstr "Det här kommandot är främst avsett för intern användning av skript som automatiskt anropar 'git merge'."

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:27
#, no-wrap, placeholders:'--log', priority:10
msgid "--log[=<n>]"
msgstr "--log[=<n>]"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:33
#, placeholders:'merge.log', priority:10
msgid "In addition to branch names, populate the log message with one-line descriptions from the actual commits that are being merged. At most <n> commits from each merge parent will be used (20 if <n> is omitted). This overrides the `merge.log` configuration variable."
msgstr "Förutom grennamn, fyll i loggmeddelandet med enradsbeskrivningar från de faktiska incheckningar som sammanfogas. Högst <n> incheckningar från varje sammanslagningsförälder kommer att användas (20 om <n> utelämnas). Detta åsidosätter konfigurationsvariabeln `merge.log`."

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:34
#, ignore-same, no-wrap, priority:10
msgid "--no-log"
msgstr "--no-log"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:37
#, priority:10
msgid "Do not list one-line descriptions from the actual commits being merged."
msgstr "Lista inte enradiga beskrivningar från de faktiska incheckningar som sammanfogas."

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:38 en/git-apply.adoc:53
#, ignore-same, no-wrap, priority:10
msgid "--summary"
msgstr "--summary"

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:39
#, ignore-same, no-wrap, priority:10
msgid "--no-summary"
msgstr "--no-summary"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:42
#, placeholders:'--log':'--no-log', priority:10
msgid "Synonyms to --log and --no-log; these are deprecated and will be removed in the future."
msgstr "Synonymer till --log och --no-log; dessa är föråldrade och kommer att tas bort i framtiden."

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:43 en/git-commit-tree.adoc:53
#, no-wrap, priority:80
msgid "-m <message>"
msgstr "-m <meddelande>"

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:44
#, no-wrap, placeholders:'--message', priority:10
msgid "--message <message>"
msgstr "--message <meddelande>"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:47
#, placeholders:'`--log`', priority:10
msgid "Use <message> instead of the branch names for the first line of the log message. For use with `--log`."
msgstr "Använd <meddelande> i stället för grennamnen för den första raden i loggmeddelandet. För användning med `--log`."

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:48
#, no-wrap, placeholders:'--into-name', priority:10
msgid "--into-name <branch>"
msgstr "--into-name <gren>"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:51
#, priority:10
msgid "Prepare the merge message as if merging to the branch `<branch>`, instead of the name of the real branch to which the merge is made."
msgstr "Förbered sammanslagningsmeddelandet som om det skulle sammanfogas med grenen `<gren>`, i stället för namnet på den riktiga grenen som sammanslagningen görs med."

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:52 en/git-commit-tree.adoc:57
#, no-wrap, priority:80
msgid "-F <file>"
msgstr "-F <fil>"

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:53
#, no-wrap, placeholders:'--file', priority:10
msgid "--file <file>"
msgstr "--file <fil>"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:56
#, priority:10
msgid "Take the list of merged objects from <file> instead of stdin."
msgstr "Hämta listan över sammanfogade objekt från <fil> i stället för stdin."

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:61
#, ignore-same, no-wrap, priority:10
msgid "merge.summary"
msgstr "merge.summary"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:64
#, placeholders:'merge.log', priority:10
msgid "Synonym to `merge.log`; this is deprecated and will be removed in the future."
msgstr "Synonym till `merge.log`; detta är föråldrat och kommer att tas bort i framtiden."

#. type: delimited block -
#: en/git-fmt-merge-msg.adoc:71
#, no-wrap, placeholders:'git fmt-merge-msg':'--log':'$GIT_DIR':'FETCH_HEAD', priority:10
msgid ""
"$ git fetch origin master\n"
"$ git fmt-merge-msg --log <$GIT_DIR/FETCH_HEAD\n"
msgstr ""
"$ git fetch origin master\n"
"$ git fmt-merge-msg --log <$GIT_DIR/FETCH_HEAD\n"

#. type: Plain text
#: en/git-fmt-merge-msg.adoc:75
#, priority:10
msgid "Print a log message describing a merge of the \"master\" branch from the \"origin\" remote."
msgstr "Skriv ut ett loggmeddelande som beskriver en sammanslagning av \"master\"-grenen från \"origin\"-fjärr."

#. type: Labeled list
#: en/git-fmt-merge-msg.adoc:80 en/cmds-mainporcelain.adoc:70
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-merge[1]"
msgstr "linkgit:git-merge[1]"

#. type: Labeled list
#: en/cmds-synchelpers.adoc:1
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-http-fetch[1]"
msgstr "linkgit:git-http-fetch[1]"

#. type: Plain text
#: en/cmds-synchelpers.adoc:3
#, priority:10
msgid "Download from a remote Git repository via HTTP."
msgstr "Hämta objekt och referenser från annat Git-kodförråd över HTTP."

#. type: Labeled list
#: en/cmds-synchelpers.adoc:4
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-http-push[1]"
msgstr "linkgit:git-http-push[1]"

#. type: Plain text
#: en/cmds-synchelpers.adoc:6
#, priority:10
msgid "Push objects over HTTP/DAV to another repository."
msgstr "Sänd objekt över HTTP/DAV till ett annat kodförråd."

#. type: Labeled list
#: en/cmds-synchelpers.adoc:7
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-receive-pack[1]"
msgstr "linkgit:git-receive-pack[1]"

#. type: Plain text
#: en/cmds-synchelpers.adoc:9
#, priority:10
msgid "Receive what is pushed into the repository."
msgstr "Ta emot det som skickas till kodförrådet."

#. type: Labeled list
#: en/cmds-synchelpers.adoc:10
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-shell[1]"
msgstr "linkgit:git-shell[1]"

#. type: Plain text
#: en/cmds-synchelpers.adoc:12
#, priority:10
msgid "Restricted login shell for Git-only SSH access."
msgstr "Begränsat inloggningsskal för SSH-åtkomst enbart till Git."

#. type: Labeled list
#: en/cmds-synchelpers.adoc:13
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-upload-archive[1]"
msgstr "linkgit:git-upload-archive[1]"

#. type: Plain text
#: en/cmds-synchelpers.adoc:15
#, placeholders:'git-archive', priority:10
msgid "Send archive back to git-archive."
msgstr "Sänd arkivet tillbaka till git-archive."

#. type: Labeled list
#: en/cmds-synchelpers.adoc:16
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-upload-pack[1]"
msgstr "linkgit:git-upload-pack[1]"

#. type: Plain text
#: en/cmds-synchelpers.adoc:18
#, placeholders:'git-fetch-pack', priority:10
msgid "Send objects packed back to git-fetch-pack."
msgstr "Sänd packade objekt tillbaka till git-fetch-pack."

#. type: Title =
#: en/git-init-db.adoc:2
#, ignore-same, no-wrap, priority:10
msgid "git-init-db(1)"
msgstr "git-init-db(1)"

#. type: Plain text
#: en/git-init-db.adoc:7
#, placeholders:'git-init-db', priority:10
msgid "git-init-db - Creates an empty Git repository"
msgstr "git-init-db - Skapar ett tomt Git-kodförråd"

#. type: verse
#: en/git-init-db.adoc:13
#, no-wrap, placeholders:'git init-db':'--quiet]':'[--bare]':'[--template=':'[--shared', priority:10
msgid "'git init-db' [-q | --quiet] [--bare] [--template=<template-directory>] [--separate-git-dir <git-dir>] [--shared[=<permissions>]]\n"
msgstr "'git init-db' [-q | --quiet] [--bare] [--template=<mallkatalog>] [--separate-git-dir <git-kat>] [--shared[=<behörigheter>]]\n"

#. type: Plain text
#: en/git-init-db.adoc:20
#, placeholders:'linkgit:git-init[1]', priority:10
msgid "This is a synonym for linkgit:git-init[1]. Please refer to the documentation of that command."
msgstr "Det här är en synonym för linkgit:git-init[1]. Se dokumentationen för det kommandot."

#. type: Title =
#: en/git-init.adoc:2
#, ignore-same, no-wrap, priority:300
msgid "git-init(1)"
msgstr "git-init(1)"

#. type: Plain text
#: en/git-init.adoc:7
#, placeholders:'git-init', priority:300
msgid "git-init - Create an empty Git repository or reinitialize an existing one"
msgstr "git-init - Skapa tomt Git-kodförråd eller ominitialisera ett befintligt"

#. type: synopsis
#: en/git-init.adoc:17
#, no-wrap, placeholders:'--quiet]':'[--bare]':'[--template=':'[--object-format=':'[--ref-format=':'--initial-branch=':'[--shared', priority:300
msgid ""
"git init [-q | --quiet] [--bare] [--template=<template-directory>]\n"
"\t [--separate-git-dir <git-dir>] [--object-format=<format>]\n"
"\t [--ref-format=<format>]\n"
"\t [-b <branch-name> | --initial-branch=<branch-name>]\n"
"\t [--shared[=<permissions>]] [<directory>]\n"
msgstr ""
"git init [-q | --quiet] [--bare] [--template=<mallkatalog>]\n"
"\t [--separate-git-dir <git-kat>] [--object-format=<format>]\n"
"\t [--ref-format=<format>]\n"
"\t [-b <gren-namn> | --initial-branch=<grennamn>]\n"
"\t [--shared[=<behörigheter>]] [<katalog>]\n"

#. type: Plain text
#: en/git-init.adoc:27
#, placeholders:'`--initial-branch`', priority:300
msgid "This command creates an empty Git repository - basically a `.git` directory with subdirectories for `objects`, `refs/heads`, `refs/tags`, and template files. An initial branch without any commits will be created (see the `--initial-branch` option below for its name)."
msgstr "Det här kommandot skapar ett tomt Git-kodförråd - i princip en `.git`-katalog med underkataloger för `objects`, `refs/heads`, `refs/tags` och mallfiler. En initial branch utan några incheckningar kommer att skapas (se alternativet `--initial-branch` nedan för dess namn)."

#. type: Plain text
#: en/git-init.adoc:30
#, placeholders:'GIT_DIR', priority:300
msgid "If the `GIT_DIR` environment variable is set then it specifies a path to use instead of `./.git` for the base of the repository."
msgstr "Om miljövariabeln `GIT_DIR` är satt anger den en sökväg som ska användas i stället för `./.git` för basen av kodförrådet."

#. type: Plain text
#: en/git-init.adoc:35
#, placeholders:'GIT_OBJECT_DIRECTORY':'`$GIT_DIR/objects`', priority:300
msgid "If the object storage directory is specified via the `GIT_OBJECT_DIRECTORY` environment variable then the sha1 directories are created underneath; otherwise, the default `$GIT_DIR/objects` directory is used."
msgstr "Om objektlagringskatalogen anges via miljövariabeln `GIT_OBJECT_DIRECTORY` sen skapas sha1-katalogerna under; annars används standardkatalogen `$GIT_DIR/objects`."

#. type: Plain text
#: en/git-init.adoc:40
#, priority:300
msgid "Running `git init` in an existing repository is safe. It will not overwrite things that are already there. The primary reason for rerunning `git init` is to pick up newly added templates (or to move the repository to another place if `--separate-git-dir` is given)."
msgstr "Att köra `git init` i ett befintligt kodförråd är säkert. Det kommer inte att skriva över saker som redan finns där. Den främsta anledningen till att köra `git init` igen är att hämta nyligen tillagda mallar (eller att flytta kodförråd till en annan plats om `--separate-git-dir` anges)."

#. type: Plain text
#: en/git-init.adoc:48
#, priority:300
msgid "Only print error and warning messages; all other output will be suppressed."
msgstr "Skriv endast ut fel- och varningsmeddelanden; all annan utmatning kommer att undertryckas."

#. type: Labeled list
#: en/git-init.adoc:49 en/git-clone.adoc:170
#, ignore-same, no-wrap, priority:300
msgid "`--bare`"
msgstr "`--bare`"

#. type: Plain text
#: en/git-init.adoc:53
#, placeholders:'GIT_DIR', priority:300
msgid "Create a bare repository. If `GIT_DIR` environment is not set, it is set to the current working directory."
msgstr "Skapa ett bart kodförråd. Om `GIT_DIR`-miljön inte är inställd, sätts den till den aktuella arbetskatalogen."

#. type: Labeled list
#: en/git-init.adoc:54
#, no-wrap, placeholders:'`--object-format=', priority:300
msgid "`--object-format=<format>`"
msgstr "`--object-format=<format>`"

#. type: Plain text
#: en/git-init.adoc:57
#, priority:300
msgid "Specify the given object _<format>_ (hash algorithm) for the repository. The valid values are `sha1` and (if enabled) `sha256`. `sha1` is the default."
msgstr "Ange det givna objektet _<format>_ (hashalgoritm) för kodförrådet. Giltiga värden är `sha1` och (om aktiverat) `sha256`. `sha1` är standardvärdet."

#. type: Labeled list
#: en/git-init.adoc:60
#, no-wrap, placeholders:'`--ref-format=', priority:300
msgid "`--ref-format=<format>`"
msgstr "`--ref-format=<format>`"

#. type: Plain text
#: en/git-init.adoc:62
#, priority:300
msgid "Specify the given ref storage _<format>_ for the repository. The valid values are:"
msgstr "Ange den givna referenslagrings-_<format>_ för kodförrådet. Giltiga värden är:"

#. type: Labeled list
#: en/git-init.adoc:65 en/git-clone.adoc:254
#, no-wrap, placeholders:'`--template=', priority:300
msgid "`--template=<template-directory>`"
msgstr "`--template=<mallkatalog>`"

#. type: Plain text
#: en/git-init.adoc:68
#, priority:300
msgid "Specify the directory from which templates will be used. (See the \"TEMPLATE DIRECTORY\" section below.)"
msgstr "Ange katalogen från vilken mallarna ska användas. (Se avsnittet \"MALLKATALOG\" nedan.)"

#. type: Labeled list
#: en/git-init.adoc:69 en/git-clone.adoc:344
#, no-wrap, priority:300
msgid "`--separate-git-dir=<git-dir>`"
msgstr "`--separate-git-dir=<git-kat>`"

#. type: Plain text
#: en/git-init.adoc:74
#, placeholders:'`$GIT_DIR`', priority:300
msgid "Instead of initializing the repository as a directory to either `$GIT_DIR` or `./.git/`, create a text file there containing the path to the actual repository. This file acts as a filesystem-agnostic Git symbolic link to the repository."
msgstr "I stället för att initiera kodförrådet som en katalog till antingen `$GIT_DIR` eller `./.git/`, skapa en textfil där som innehåller sökvägen till själva kodförrådet. Denna fil fungerar som en filsystemsoberoende symbolisk Git-länk till kodförrådet."

#. type: Plain text
#: en/git-init.adoc:76
#, priority:300
msgid "If this is a reinitialization, the repository will be moved to the specified path."
msgstr "Om detta är en ominitialisering, kodförrådet kommer att flyttas till den angivna sökvägen."

#. type: Labeled list
#: en/git-init.adoc:77
#, no-wrap, priority:300
msgid "`-b <branch-name>`"
msgstr "`-b <gren-namn>`"

#. type: Labeled list
#: en/git-init.adoc:78
#, no-wrap, placeholders:'`--initial-branch=', priority:300
msgid "`--initial-branch=<branch-name>`"
msgstr "`--initial-branch=<gren-namn>`"

#. type: Plain text
#: en/git-init.adoc:81
#, priority:300
msgid "Use _<branch-name>_ for the initial branch in the newly created repository. If not specified, fall back to the default name"
msgstr "Använd _<gren-namn>_ för den initiala grenen i det nyskapade kodförrådet. Om inget namn anges, återgå till standardnamnet"

#. type: Plain text
#: en/git-init.adoc:83
#, priority:300
msgid "(currently `master`, but this will change to `main` when Git 3.0 is released)."
msgstr "(för närvarande `master`, men detta kommer att ändras till `main` när Git 3.0 släpps)."

#. type: Plain text
#: en/git-init.adoc:86
#, priority:300
msgid "`main`."
msgstr "`main`."

#. type: Plain text
#: en/git-init.adoc:89
#, placeholders:'init.defaultBranch', priority:300
msgid "The default name can be customized via the `init.defaultBranch` configuration variable."
msgstr "Standardnamnet kan anpassas via konfigurationsvariabeln `init.defaultBranch`."

#. type: Labeled list
#: en/git-init.adoc:90
#, no-wrap, placeholders:'`--shared', priority:300
msgid "`--shared[=(false|true|umask|group|all|world|everybody|<perm>)]`"
msgstr "`--shared[=(false|true|umask|group|all|world|everybody|<behörigheter>)]`"

#. type: Plain text
#: en/git-init.adoc:98
#, placeholders:'core.sharedRepository':'`$GIT_DIR`', priority:300
msgid "Specify that the Git repository is to be shared amongst several users. This allows users belonging to the same group to push into that repository. When specified, the config variable `core.sharedRepository` is set so that files and directories under `$GIT_DIR` are created with the requested permissions. When not specified, Git will use permissions reported by `umask`(2)."
msgstr "Ange att Git-kodförrådet ska delas mellan flera användare. Detta gör det möjligt för användare som tillhör samma grupp att skicka in i det kodförrådet. När den anges ställs konfigurationsvariabeln `core.sharedRepository` in så att filer och kataloger under `$GIT_DIR` skapas med de begärda behörigheterna. När den inte anges, kommer Git att använda behörigheter som rapporteras av `umask`(2)."

#. type: Plain text
#: en/git-init.adoc:101
#, priority:300
msgid "The option can have the following values, defaulting to `group` if no value is given:"
msgstr "Alternativet kan ha följande värden, med standardvärde `group` om inget värde anges:"

#. type: Labeled list
#: en/git-init.adoc:103
#, ignore-same, no-wrap, priority:300
msgid "`umask`"
msgstr "`umask`"

#. type: Plain text
#: en/git-init.adoc:108
#, placeholders:'`--shared`', priority:300
msgid "Use permissions reported by `umask`(2). The default, when `--shared` is not specified."
msgstr "Använd behörigheter som rapporteras av `umask`(2). Standardvärdet när `--shared` inte anges."

#. type: Labeled list
#: en/git-init.adoc:109
#, ignore-same, no-wrap, priority:300
msgid "`group`"
msgstr "`group`"

#. type: Plain text
#: en/git-init.adoc:118
#, priority:300
msgid "Make the repository group-writable, (and `g+sx`, since the git group may not be the primary group of all users). This is used to loosen the permissions of an otherwise safe `umask`(2) value. Note that the umask still applies to the other permission bits (e.g. if umask is `0022`, using `group` will not remove read privileges from other (non-group) users). See `0xxx` for how to exactly specify the repository permissions."
msgstr "Gör kodförrådet skrivbart i grupp (och `g+sx`, eftersom git-gruppen kanske inte är den primära gruppen för alla användare). Detta används för att lätta upp behörigheterna för ett annars säkert `umask`(2)-värde. Observera att umasken fortfarande gäller för de andra behörighetsbitarna (t.ex. om umask är `0022`, kommer användning av `group` inte att ta bort läsbehörigheter från andra (icke-grupp) användare). Se `0xxx` för hur du exakt anger kodförrådets behörigheter."

#. type: Labeled list
#: en/git-init.adoc:119 en/git-commit.adoc:351 en/git-status.adoc:72 en/git-status.adoc:103
#, ignore-same, no-wrap, priority:300
msgid "`all`"
msgstr "`all`"

#. type: Labeled list
#: en/git-init.adoc:120
#, ignore-same, no-wrap, priority:300
msgid "`world`"
msgstr "`world`"

#. type: Labeled list
#: en/git-init.adoc:121
#, ignore-same, no-wrap, priority:300
msgid "`everybody`"
msgstr "`everybody`"

#. type: Plain text
#: en/git-init.adoc:124
#, priority:300
msgid "Same as `group`, but make the repository readable by all users."
msgstr "Samma som `group`, men gör kodförrådet läsbart för alla användare."

#. type: Labeled list
#: en/git-init.adoc:125
#, no-wrap, priority:300
msgid "_<perm>_"
msgstr "_<behörigheter>_"

#. type: Plain text
#: en/git-init.adoc:135
#, priority:300
msgid "_<perm>_ is a 3-digit octal number prefixed with `0` and each file will have mode _<perm>_. _<perm>_ will override users' `umask`(2) value (and not only loosen permissions as `group` and `all` do). `0640` will create a repository which is group-readable, but not group-writable or accessible to others. `0660` will create a repo that is readable and writable to the current user and group, but inaccessible to others (directories and executable files get their `x` bit from the `r` bit for corresponding classes of users)."
msgstr "<behörigheter> _<perm>_ är ett 3-siffrigt oktalt tal prefixerat med `0` och varje fil kommer att ha läget _<behörigheter>_. _<behörigheter>_ kommer att åsidosätta användarnas `umask`(2) värde (och inte bara lossa behörigheter som `group` och `all` gör). `0640` kommer att skapa ett kodförråd som är gruppläsbart, men inte gruppskrivbart eller tillgängligt för andra. `0660` kommer att skapa ett kodförråd som är läsbart och skrivbart för den aktuella användaren och gruppen, men oåtkomligt för andra (kataloger och körbara filer får sin `x` bit från `r` biten för motsvarande klasser av användare)."

#. type: Plain text
#: en/git-init.adoc:140
#, placeholders:'receive.denyNonFastForwards', priority:300
msgid "By default, the configuration flag `receive.denyNonFastForwards` is enabled in shared repositories, so that you cannot force a non fast-forwarding push into it."
msgstr "Som standard är konfigurationsflaggan `receive.denyNonFastForwards` aktiverad i delade kodförråd, så att du inte kan tvinga fram att skicka utan snabbspolning (\"push\") till dem."

#. type: Plain text
#: en/git-init.adoc:143
#, priority:300
msgid "If you provide a _<directory>_, the command is run inside it. If this directory does not exist, it will be created."
msgstr "Om du anger en _<katalog>_, körs kommandot inuti den. Om den här katalogen inte finns, kommer den att skapas."

#. type: Title -
#: en/git-init.adoc:145
#, no-wrap, priority:300
msgid "TEMPLATE DIRECTORY"
msgstr "MALLKATALOG"

#. type: Plain text
#: en/git-init.adoc:149
#, placeholders:'`$GIT_DIR`', priority:300
msgid "Files and directories in the template directory whose name do not start with a dot will be copied to the `$GIT_DIR` after it is created."
msgstr "Filer och kataloger i mallkatalogen vars namn inte börjar med en punkt kommer att kopieras till `$GIT_DIR` efter att den har skapats."

#. type: Plain text
#: en/git-init.adoc:151
#, priority:300
msgid "The template directory will be one of the following (in order):"
msgstr "Mallkatalogen kommer att vara en av följande (i ordning):"

#. type: Plain text
#: en/git-init.adoc:153
#, placeholders:'`--template`', priority:300
msgid "the argument given with the `--template` option;"
msgstr "argumentet som ges med alternativet `--template`;"

#. type: Plain text
#: en/git-init.adoc:155
#, placeholders:'`$GIT_TEMPLATE_DIR`', priority:300
msgid "the contents of the `$GIT_TEMPLATE_DIR` environment variable;"
msgstr "innehållet i miljövariabeln `$GIT_TEMPLATE_DIR`;"

#. type: Plain text
#: en/git-init.adoc:157
#, placeholders:'init.templateDir', priority:300
msgid "the `init.templateDir` configuration variable; or"
msgstr "konfigurationsvariabeln `init.templateDir`; eller"

#. type: Plain text
#: en/git-init.adoc:159
#, placeholders:'git-core', priority:300
msgid "the default template directory: `/usr/share/git-core/templates`."
msgstr "standardmallkatalogen: `/usr/share/git-core/templates`."

#. type: Plain text
#: en/git-init.adoc:162
#, placeholders:'linkgit:gitignore[5]', priority:300
msgid "The default template directory includes some directory structure, suggested \"exclude patterns\" (see linkgit:gitignore[5]), and sample hook files."
msgstr "Standardmallkatalogen innehåller en viss katalogstruktur, föreslagna \"exkluderingsmönster\" (se linkgit:gitignore[5]) och exempel på krok-filer."

#. type: Plain text
#: en/git-init.adoc:165
#, priority:300
msgid "The sample hooks are all disabled by default. To enable one of the sample hooks rename it by removing its `.sample` suffix."
msgstr "Exempelkrokar är inaktiverade som standard. För att aktivera en av dem, byt namn på den genom att ta bort suffixet `.sample`."

#. type: Plain text
#: en/git-init.adoc:167
#, placeholders:'linkgit:githooks[5]', priority:300
msgid "See linkgit:githooks[5] for more general info on hook execution."
msgstr "Se linkgit:githooks[5] för mer allmän information om krok-exekvering."

#. type: Labeled list
