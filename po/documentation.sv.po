#. type: Plain text
#: en/git-shortlog.adoc:54
#, fuzzy, placeholders:'`--date`':'linkgit:git-log[1]':'`--group=format', priority:260
#| msgid "Show dates formatted according to the given date string. (See the `--date` option in the \"Commit Formatting\" section of linkgit:git-log[1]). Useful with `--group=format:<format>`."
msgid "Show dates formatted according to the given date string. (See the `--date` option in the 'Commit Formatting' section of linkgit:git-log[1]). Useful with `--group=format:<format>`."
msgstr "Visa datum formaterade enligt den givna datumsträngen. (Se alternativet `--date` i avsnittet \"Incheckningsformatering\" i linkgit:git-log[1]). Användbart med `--group=format:<format>`."

#. type: Labeled list
