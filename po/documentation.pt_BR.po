#, ignore-same, no-wrap, priority:10
msgid "`badDate`"
msgstr "`badDate`"

#. type: Plain text
#: en/fsck-msgids.adoc:3
#, priority:10
msgid "(ERROR) Invalid date format in an author/committer line."
msgstr ""

