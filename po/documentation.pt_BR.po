"\t\t   [ --stdin | <padrão>... ]\n"
"\t\t   [--points-at=<objeto>]\n"
"\t\t   [--merged[=<objeto>]] [--no-merged[=<objeto>]]\n"
"\t\t   [--contains[=<objeto>]] [--no-contains[=<objeto>]]\n"
