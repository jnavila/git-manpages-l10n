msgid "git-show - Show various types of objects"
msgstr "git-show - Exibe vários tipos de objetos"

#. type: synopsis
#: en/git-show.adoc:13
#, fuzzy, ignore-ellipsis, no-wrap, priority:240
#| msgid "'git show' [<options>] [<object>...]\n"
msgid "git show [<options>] [<object>...]\n"
