#. type: Title -
#: en/git-push.adoc:448
#, fuzzy, no-wrap, priority:220
#| msgid "REMOTE_USER"
msgid "REMOTE GROUPS"
msgstr "REMOTE_USER"

#. type: Plain text
#: en/git-push.adoc:452
#, priority:220
msgid "A remote group is a named list of remotes configured via `remotes.<name>` in your git config:"
msgstr ""

#. type: Plain text
#: en/git-push.adoc:454
#, no-wrap, placeholders:'remotes.all', priority:220
msgid "\t$ git config remotes.all-remotes \"r1 r2 r3\"\n"
msgstr ""

#. type: Plain text
#: en/git-push.adoc:457
#, priority:220
msgid "When a group name is given as the `<repository>` argument, the push is performed to each member remote in turn. The defining principle is:"
msgstr ""

#. type: Plain text
#: en/git-push.adoc:459
#, fuzzy, no-wrap, priority:220
#| msgid "'git mv' <options>... <args>...\n"
msgid "\tgit push <options> all-remotes <args>\n"
msgstr "'git mv' <opções>... <args>...\n"

#. type: Plain text
#: en/git-push.adoc:461
#, fuzzy, priority:220
#| msgid "It is a rough equivalent for:"
msgid "is exactly equivalent to:"
msgstr "É grosseiramente um equivalente para:"

#. type: Plain text
#: en/git-push.adoc:466
#, ignore-ellipsis, no-wrap, priority:220
msgid ""
"\tgit push <options> r1 <args>\n"
"\tgit push <options> r2 <args>\n"
"\t...\n"
"\tgit push <options> rN <args>\n"
msgstr ""

#. type: Plain text
#: en/git-push.adoc:470
#, ignore-ellipsis, priority:220
msgid "where r1, r2, ..., rN are the members of `all-remotes`. No special behaviour is added or removed — the group is purely a shorthand for running the same push command against each member remote individually."
msgstr ""

#. type: Plain text
#: en/git-push.adoc:478
#, priority:220
msgid "When pushing to a group of more than one remote, Git spawns a separate `git push` subprocess for each member remote in sequence. Each subprocess receives the same flags and refspecs as the original invocation. This means that per-remote push mappings configured via `remote.<name>.push` and mirror mode (`remote.<name>.mirror`) are evaluated independently for each remote, and a mirror remote in the group cannot affect the push behaviour of other non-mirror remotes in the same group."
msgstr ""

#. type: Plain text
#: en/git-push.adoc:483
#, placeholders:'`--atomic`':'`--atomic`', priority:220
msgid "The `--atomic` option is not supported for group pushes, because atomicity can only be guaranteed within a single transport connection to a single remote. Git will refuse the invocation with an error if `--atomic` is combined with a group name."
msgstr ""

#. type: Plain text
#: en/git-push.adoc:490
#, priority:220
msgid "If any member remote fails whether due to a push rejection (e.g. a non-fast-forward update, a server-side hook refusing a ref) or a connection error (e.g. the repository does not exist, authentication fails, or the network is unreachable), Git reports the error and continues pushing to the remaining remotes in the group. The overall exit code is non-zero if any member push fails."
msgstr ""

#. type: Plain text
#: en/git-push.adoc:496
#, priority:220
msgid "This means the user is responsible for ensuring that the sequence of individual pushes makes sense. If `git push r1`` would fail for a given set of options and arguments, then `git push all-remotes` will fail in the same way when it reaches r1. The group push does not do anything special to make a failing individual push succeed."
msgstr ""

#. type: Title -
#: en/git-push.adoc:498 en/git-check-attr.adoc:54 en/git-show-ref.adoc:113 en/git-ls-remote.adoc:105 en/git-fetch.adoc:194 en/git-show-branch.adoc:133 en/git-cvsimport.adoc:188 en/git-ls-files.adoc:235 en/git-check-ignore.adoc:69 en/git-merge-tree.adoc:101 en/git-cat-file.adoc:286 en/git-check-mailmap.adoc:42 en/git-update-server-info.adoc:29 en/git-status.adoc:161
#, no-wrap, priority:280
msgid "OUTPUT"
