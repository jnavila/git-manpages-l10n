msgstr "O repositório \"remote\" é a fonte de uma operação 'fetch' ou 'pull'. Este parâmetro pode ser uma URL (consulte a seção <<URLS,GIT URLS>> abaixo) ou o nome de um controle remoto (consulte a seção <<REMOTES,RAMOS REMOTOS>> abaixo)."

#. type: Labeled list
#: en/pull-fetch-param.adoc:8
#, fuzzy, no-wrap, priority:220
#| msgid "<group>"
msgid "_<group>_"
msgstr "<grupo>"

#. type: Plain text
#: en/pull-fetch-param.adoc:12
#, fuzzy, placeholders:'linkgit:git-config[1]', priority:220
#| msgid "A name referring to a list of repositories as the value of remotes.<group> in the configuration file. (See linkgit:git-config[1])."
msgid "A name referring to a list of repositories as the value of `remotes.<group>` in the configuration file. (See linkgit:git-config[1])."
msgstr "Um nome referente a uma lista de repositórios remotos como o valor de `remotes.<grupo>` no arquivo de configuração. (consulte linkgit:git-config[1])."

#. type: Labeled list
#: en/pull-fetch-param.adoc:15 en/git-pull.adoc:55
