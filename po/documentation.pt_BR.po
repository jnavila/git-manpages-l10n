"*--*--*--*--*--* refs/heads/A\n"
"\\\n"
" \\\n"
"  *--*--*--* refs/heads/B\n"
"   \\     \\\n"
"    \\     \\\n"
"     *     * refs/heads/C\n"
"      \\\n"
"       \\\n"
"\t*--* refs/heads/D\n"
msgstr ""

#. type: Plain text
#: en/git-for-each-ref.adoc:218
#, priority:80
msgid "Here, if `A`, `B`, and `C` are the filtered references, and the format string is `%(refname):%(is-base:D)`, then the output would be"
msgstr ""

#. type: delimited block -
#: en/git-for-each-ref.adoc:223
#, fuzzy, no-wrap, priority:80
#| msgid "\trefs/heads/<head>:refs/heads/<branch>\n"
