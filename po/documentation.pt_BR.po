msgstr "nenhuma seção ou nome foi informado (`ret=2`),"

#. type: Plain text
#: en/git-config.adoc:60
#, priority:10
msgid "the config file is invalid (ret=3),"
msgstr "o arquivo de configuração é inválido (`ret=3`),"

