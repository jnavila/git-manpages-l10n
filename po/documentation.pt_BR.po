msgstr "git-fetch(1)"

#. type: Plain text
#: en/git-fetch.adoc:7
#, placeholders:'git-fetch', priority:220
msgid "git-fetch - Download objects and refs from another repository"
msgstr "git-fetch - Faz o download dos objetos e `refs` do outro repositório"

#. type: synopsis
#: en/git-fetch.adoc:16
#, fuzzy, ignore-ellipsis, no-wrap, placeholders:'--multiple':'--all', priority:220
#| msgid ""
