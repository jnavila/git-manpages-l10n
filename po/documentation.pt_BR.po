#: en/git-show-ref.adoc:202 en/git-commit.adoc:576 en/git-tag.adoc:414 en/git-svn.adoc:1139 en/git-commit-tree.adoc:91 en/git-submodule.adoc:472 en/git-config.adoc:367 en/git-credential-store.adoc:45
#, no-wrap, priority:280
msgid "FILES"
msgstr "ARQUIVOS"

#. type: Plain text
#: en/git-show-ref.adoc:204
#, priority:80
msgid "`.git/refs/*`, `.git/packed-refs`"
msgstr "`.git/refs/*`, `.git/packed-refs`"

#. type: Plain text
#: en/git-show-ref.adoc:211
#, ignore-same, priority:80
msgid "linkgit:git-for-each-ref[1], linkgit:git-ls-remote[1], linkgit:git-update-ref[1], linkgit:gitrepository-layout[5]"
msgstr "linkgit:git-for-each-ref[1], linkgit:git-ls-remote[1], linkgit:git-update-ref[1], linkgit:gitrepository-layout[5]"

#. type: Title =
#: en/git-pack-objects.adoc:2
#, ignore-same, no-wrap, priority:80
msgid "git-pack-objects(1)"
msgstr "git-pack-objects(1)"

#. type: Plain text
#: en/git-pack-objects.adoc:7
#, placeholders:'git-pack-objects', priority:80
msgid "git-pack-objects - Create a packed archive of objects"
msgstr "git-pack-objects - Crie um arquivo compactado dos objetos"

#. type: verse
#: en/git-pack-objects.adoc:20
#, fuzzy, no-wrap, placeholders:'git pack-objects':'--progress':'--all-progress]':'[--all-progress-implied]':'[--no-reuse-delta]':'[--delta-base-offset]':'[--non-empty]':'[--local]':'[--incremental]':'[--window=':'[--depth=':'[--revs':'[--unpacked':'--all]':'[--keep-pack=':'[--cruft]':'[--cruft-expiration=':'[--stdout':'[--filter=':'[--shallow]':'[--keep-true-parents]':'[--name-hash-version=':'[--path-walk]', priority:80
#| msgid ""
