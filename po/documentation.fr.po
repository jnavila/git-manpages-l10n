#, ignore-same, no-wrap, priority:260
msgid "`medium`"
msgstr "`medium`"

#. type: synopsis
#: en/pretty-formats.adoc:47
#, priority:260
msgid "commit <hash> Author: <author> Date: <author-date>"
msgstr ""
"commit <empreinte>\n"
"Author: <auteur>\n"
"Date:   <date d'auteur>"

#. type: synopsis
#: en/pretty-formats.adoc:51 en/pretty-formats.adoc:64
#, no-wrap, priority:260
msgid "    <full-commit-message>\n"
msgstr "    <message-de-commit-complet>\n"

