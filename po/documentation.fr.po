#, no-wrap, priority:80
msgid "1"
msgstr "1"

#. type: Plain text
#: en/git-check-ignore.adoc:117
#, priority:80
msgid "None of the provided paths are ignored."
msgstr "Aucun des chemins fournis n'est ignoré."

#. type: Labeled list
