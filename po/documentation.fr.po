#: en/cmds-mainporcelain.adoc:39
#, priority:10
msgid "Record changes to the repository."
msgstr "Enregistrer les modifications dans le dépôt."

#. type: Labeled list
#: en/cmds-mainporcelain.adoc:40
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-describe[1]"
msgstr "linkgit:git-describe[1]"

#. type: Plain text
#: en/cmds-mainporcelain.adoc:42
#, priority:10
msgid "Give an object a human readable name based on an available ref."
msgstr "Baptiser un objet avec un nom lisible basé sur une référence disponible."

#. type: Labeled list
#: en/cmds-mainporcelain.adoc:43 en/git-difftool.adoc:131
#, ignore-same, no-wrap, priority:10
msgid "linkgit:git-diff[1]"
