msgstr "++%><(++_<n>_++)++"

#. type: Labeled list
#: en/pretty-formats.adoc:204
#, no-wrap, priority:260
msgid "++%><|(++_<m>_++)++"
msgstr "++%><|(++_<m>_++)++"

#. type: Plain text
#: en/pretty-formats.adoc:207
#, priority:260
msgid "similar to ++%<(++_<n>_++)++, ++%<|(++_<m>_++)++ respectively, but padding both sides (i.e. the text is centered)"
msgstr "подібно до ++%<(++_<n>_++)++, ++%<|(++_<m>_++)++ відповідно, але з відступами з обох боків (тобто текст вирівнюється по центру)"

