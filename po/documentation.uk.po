msgstr "Вісімковий режим файлів у HEAD."

#. type: Table
#: en/git-status.adoc:366
#, no-wrap, priority:280
msgid "_<mI>_"
msgstr "_<mI>_"

#. type: Table
#: en/git-status.adoc:367
#, no-wrap, priority:280
msgid "The octal file mode in the index."
msgstr "Вісімковий режим файлів в індексі."

#. type: Table
#: en/git-status.adoc:367 en/git-status.adoc:401
#, no-wrap, priority:280
