#: en/git-status.adoc:315
#, no-wrap, placeholders:'branch.head', priority:280
msgid "`# branch.head <branch> \\| (detached)`"
msgstr "`# branch.head <branch> \\| (відʼєднаний)`"

#. type: Table
#: en/git-status.adoc:316
#, no-wrap, priority:280
msgid "Current branch."
msgstr "Поточна гілка."

#. type: Table
#: en/git-status.adoc:316
#, no-wrap, placeholders:'branch.upstream', priority:280
msgid "`# branch.upstream <upstream-branch>`"
msgstr "`# branch.upstream <upstream-branch>`"

#. type: Table
#: en/git-status.adoc:317
#, no-wrap, priority:280
msgid "If upstream is set."
msgstr "Якщо upstream встановлено."

