msgstr "Імʼя обʼєкта в stage 2."

#. type: Table
#: en/git-status.adoc:404
#, no-wrap, priority:280
msgid "_<h3>_"
msgstr "_<h3>_"

#. type: Table
#: en/git-status.adoc:405
#, no-wrap, priority:280
msgid "The object name in stage 3."
msgstr "Імʼя обʼєкта в stage 3."

