msgstr "дата комітера, людський стиль (як опція `--date=human` у linkgit:git-rev-list[1])"

#. type: Labeled list
#: en/pretty-formats.adoc:254
#, no-wrap, priority:260
msgid "+%d+"
msgstr "+%d+"

#. type: Plain text
