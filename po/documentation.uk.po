msgstr "Імʼя обʼєкта в stage 1."

#. type: Table
#: en/git-status.adoc:403
#, no-wrap, priority:280
msgid "_<h2>_"
msgstr "_<h2>_"

#. type: Table
#: en/git-status.adoc:404
#, no-wrap, priority:280
