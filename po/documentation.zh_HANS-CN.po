#: en/pretty-formats.adoc:40
#, ignore-same, no-wrap, priority:260
msgid "`medium`"
msgstr "`medium`"

#. type: synopsis
#: en/pretty-formats.adoc:47
#, priority:260
msgid "commit <hash> Author: <author> Date: <author-date>"
msgstr "commit <哈希值> Author: <作者> Date: <作者提交日期>"

#. type: synopsis
#: en/pretty-formats.adoc:51 en/pretty-formats.adoc:64
#, no-wrap, priority:260
msgid "    <full-commit-message>\n"
msgstr "    <完整的提交信息>\n"

#. type: synopsis
#: en/pretty-formats.adoc:60
#, priority:260
msgid "commit <hash> Author: <author> Commit: <committer>"
msgstr "commit <哈希值> Author: <作者> Commit: <提交者>"

