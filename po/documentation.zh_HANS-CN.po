#~ "\t    C在工作树中被复制\n"
#~ "-------------------------------------------------\n"
#~ "D D未合并，均已删除\n"
#~ "A U 未合并，由我们添加\n"
#~ "U D未合并，被他人删除\n"
#~ "U A 未合并，由他人添加\n"
#~ "D U未合并，被我们删除\n"
#~ "A A未合并，都被添加\n"
#~ "U U未合并，都被修改\n"
#~ "-------------------------------------------------\n"
#~ "?           未被追踪的\n"
#~ "!           忽略不计\n"
#~ "-------------------------------------------------\n"

