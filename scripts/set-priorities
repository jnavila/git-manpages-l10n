#!/usr/bin/python3

import polib
import sys
from os.path import join
from sources import SECTIONS, included_paths

DEFAULT_PRIORITY = 10

def process_file(source, priority, priorities, visited):
    if source in visited:
        return
    visited.add(source)
    try:
        with open(join('en', source), encoding="utf-8") as f:
            for included in included_paths(source, f):
                priorities[included] = max(priority, priorities.get(included, 100))
                process_file(included, priority, priorities, visited)
    except FileNotFoundError:
        print("could not find " + join('en', source))


def main(f_list):
    priorities = {source: section for section, sources in SECTIONS.items() for source in sources}
    for source, priority in list(priorities.items()):
        process_file(source, priority, priorities, set())
    by_filename = {join('en', source): priority for source, priority in priorities.items()}
    for source in f_list:
        po = polib.pofile(source, wrapwidth=0)
        for entry in po:
            if not entry.obsolete:
                flags = [f for f in entry.flags if not (f.startswith("priority") or f.isdigit())]
                p = max(by_filename.get(filename, DEFAULT_PRIORITY) for (filename, _) in entry.occurrences)
                flags.append("priority:{}".format(p))
                entry.flags = flags
        po.save(source)


if __name__ == '__main__':
    if len(sys.argv) > 1:
        main(sys.argv[1:])
