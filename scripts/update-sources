#!/usr/bin/env python3
import filecmp
import os
from os.path import join
from pathlib import Path
import shutil
from sources import SECTIONS, included_paths

relative_path = os.getenv("SOURCE_PATH", "..")

def copy_file(source: str) -> None:
    path = join(relative_path, source)
    destination = join("en", source)
    if os.path.isfile(destination) and filecmp.cmp(path, destination, shallow=False):
        return
    os.makedirs(os.path.dirname(destination), exist_ok=True)
    # po4a uses the local modification time to detect changed inputs.
    shutil.copy(path, destination)

def collect_includes(source: str, selected: set) -> None:
    if source in selected:
        return
    path = join(relative_path, source)
    try:
        f = open(path, encoding="utf-8")
    except FileNotFoundError:
        raise SystemExit(f"Required documentation source not found: {path}")
    selected.add(source)
    with f:
        for target in included_paths(source, f):
            collect_includes(target, selected)


version_file = join(relative_path, "..", "GIT-VERSION-FILE")
if not os.path.isfile(version_file):
    raise SystemExit(f"Required version file not found: {version_file}")

english = Path("en")
# po4a uses every English AsciiDoc input. A newly listed manual may not have
# a local copy yet, so include explicit selections on their first update too.
roots = {str(path.relative_to(english)) for path in english.rglob("*.adoc")}
for sources in SECTIONS.values():
    roots.update(sources)

selected = set()
for source in sorted(roots):
    collect_includes(source, selected)
for source in sorted(selected):
    copy_file(source)
shutil.copy2(version_file, ".")
