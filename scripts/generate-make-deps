#!/usr/bin/python3

import sys
from pathlib import Path
from sources import included_paths


def process_file(filename, deps):
    if filename in deps:
        return
    try:
        with open(filename, encoding="utf-8") as f:
            deps[filename] = set()
            for included in included_paths(filename, f):
                process_file(included, deps)
                if deps[included] is not None:
                    deps[filename].add(included)
                    deps[filename].update(deps[included])
    except FileNotFoundError:
        # Incomplete translations may fall below the per-file threshold.
        deps[filename] = None


def main(f_list):
    deps = {}
    rules = []
    for source in f_list:
        process_file(source, deps)
        if deps[source]:
            prerequisites = " ".join(sorted(deps[source]))
            for suffix in (".html", ".1", ".5", ".7"):
                rules.append(f"{Path(source).with_suffix(suffix)}: {source} {prerequisites}\n")

    makefile = Path("make-deps.mk")
    content = "".join(rules)
    if not makefile.exists() or makefile.read_text() != content:
        makefile.write_text(content)

if __name__ == '__main__':
    if len(sys.argv) > 1:
        main(sys.argv[1:])
